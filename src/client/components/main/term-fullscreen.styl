.fullscreen
  .sidebar
  .tabs
  .terminal-footer
  .terminal-control
  .qm-wrap-tooltip
  .main-footer
  .remote-monitor-bar
  .session-v-info
  // 全屏时右侧面板与左侧图标栏同口径隐藏：会话区固定铺满窗口（width
  // 100% !important），面板 absolute 覆盖在右侧会遮挡远程桌面/终端内容
  .right-side-panel
    display none
  // Mobile tabs carry the extra .mobile-tabs class, and mobile.styl uses
  // .is-mobile .tabs.mobile-tabs (specificity 0,3,0) which overrides the
  // .fullscreen .tabs rule above (0,2,0). This ensures they stay hidden.
  .tabs.mobile-tabs
    display none
  // Hide all sessions first
  .session-wrap
    display none
  // Only show the session that matches the fullscreen tab ID
  .session-wrap.session-current
    display block !important
    position fixed
    left 0 !important
    top 0 !important
    height 100% !important
    width 100% !important
    .term-wrap
    .session-v-wrap
      position fixed
      left 0 !important
      top 0 !important
      height 100% !important
      width 100% !important
    .term-wrap-1
      left 10px !important
      top 10px !important
      right 10px !important
      bottom 10px !important
    // 数据库页内容区：内联高度是布局高（非全屏高），全屏时固定铺满；
    // 保留底栏时由 .fs-with-footer 覆写 bottom 让出底栏
    .db-session-box
      position fixed
      left 0 !important
      top 0 !important
      right 0 !important
      bottom 0 !important
      width auto !important
      height auto !important

// 右面板在全屏下统一隐藏（见顶部 hide 列表），其定位规则不再需要。

// Terminal fullscreen keeps the footer (and the quick-command popup above it)
// visible; the session shrinks to sit on top of the footer. RDP/VNC/Spice
// fullscreen stays footer-less — inActiveTerminal is false for those tabs, so
// the fs-with-footer class is absent there.
// --footer-stack-height includes the 30px footer and the optional monitor row.
.fullscreen.fs-with-footer
  .main-footer
    display block
    left 0 !important
  &.remote-monitor-bar-on
    .remote-monitor-bar
      display flex
      left 0 !important
      width 100% !important
  .qm-wrap-tooltip
    display block
    left 0 !important
  // sidebar is hidden in fullscreen; hide the footer control that opens it
  .terminal-footer-show-sidebar
    display none
  // 右面板在全屏下隐藏，底栏对应的打开入口一并隐藏，
  // 避免"点了没反应"；编码选择等其它 terminal-footer-info 单元不受影响
  .terminal-footer-ai
  .terminal-footer-transfer
  .terminal-footer-monitor
  .terminal-footer-info:has(.terminal-info-icon)
    display none
  .session-wrap.session-current
    .term-wrap
      height calc(100% - var(--footer-stack-height, 30px) - var(--shortcut-bar-h, 0px) - var(--shortcut-bar-kb-offset, 0px)) !important
    // 数据库页：内容区定高容器在内联样式里钉的是布局高（非全屏高度），
    // 全屏时改成固定铺满（底栏保留时让出底栏）
    .db-session-box
      bottom var(--footer-stack-height, 30px) !important
  // pinned quick-command bar (180px, same as quickCommandBoxHeight) sits
  // between terminal and footer — reserve its space too
  &.qm-pinned
    .session-wrap.session-current
      .term-wrap
        height calc(100% - var(--footer-stack-height, 30px) - 180px - var(--shortcut-bar-h, 0px) - var(--shortcut-bar-kb-offset, 0px)) !important

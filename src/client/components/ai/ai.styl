.ai-chat-container
  height 100%
  display flex
  flex-direction column

.ai-chat-history
  flex-grow 1
  min-height 0
  &::-webkit-scrollbar
    width 0
.ai-history-wrap
  width 100%
  overflow-y auto
  overflow-x hidden

.chat-history-item
  position relative
  > .ai-stop-icon-square
    position absolute
    bottom 8px
    right 8px
    z-index 10
  .code-block
    border 1px dashed var(--border)
    padding 5px
    border-radius var(--radius-xs)
    pre
      margin-bottom 0

// copy icons stay visible all the time, never hover only
.copy-icon,
.code-action-icon
  color var(--text-dark)
  font-size 14px
  &:hover
    color var(--primary)

.code-block-actions
  display flex
  justify-content flex-end

// left aligned on purpose: the streaming stop/loading icon is pinned to the
// bottom right of .chat-history-item, so a right aligned copy icon would sit
// on top of it while a response is streaming
.ai-output-actions
  display flex
  justify-content flex-start
  margin-top 6px

.ai-stream-output
  position relative
  max-height 400px
  overflow-y auto
  &::-webkit-scrollbar-thumb
    background var(--main-dark)
.ai-stream-output-flag
  position absolute
  top 13px
  right 10px
  z-index 10

// markdown (react-markdown, GFM) tables in the AI answer. Just enough to be a
// usable table, using the theme's own colours.
// display:block + overflow-x:auto is the load bearing part: .ai-history-wrap is
// overflow-x hidden, so a table wider than the panel would otherwise be clipped
// with no way to reach its right hand columns. width:max-content keeps it
// shrink-to-fit while it still fits.
.ai-stream-output
  table
    display block
    width max-content
    max-width 100%
    overflow-x auto
    border-collapse collapse
  th,
  td
    border 1px solid var(--main-darker)
    padding 4px 8px
    text-align left


.ai-chat-input
  position relative
  margin-top 10px

  .ant-input
    padding-bottom 40px

  .ai-chat-terminals
    position absolute
    bottom 5px
    left 5px
    right 5px
    background transparent
    z-index 1
    font-size 16px

.ai-disclamer
  font-size 12px

.code-block
  width 100%
  // 对齐草图 .ai-msg code：surface-3 底 + 小圆角 + 等宽
  border-radius var(--radius-xs)
  background var(--surface-3)
  padding 6px 8px
  pre
    white-space pre-wrap
    word-wrap break-word
    overflow-x auto
    max-width 100%
    margin 0
  code
    font-family var(--font-mono)
    font-size 11px
    white-space pre-wrap
    word-break break-all

// 对齐草图 .ai-msg / .ai-msg.me：对话气泡左右分栏
// —— 用户提问（antd Alert）靠右 + 品牌浸染；AI 回复靠左 + 中性卡片
.chat-history-item
  .ant-alert
    margin-left auto
    max-width 92%
    border-radius var(--radius)
    background var(--active-bg)
    border-color unquote('color-mix(in srgb, var(--primary) 30%, transparent)')
  .ai-stream-output
    margin-right auto
    max-width 96%
    border-radius var(--radius)
    border 1px solid var(--border)
    background var(--surface-1)

.send-to-ai-icon.disabled
  opacity 0.4
  cursor not-allowed

.ai-chat-attachments
  padding 0 2px
  .ant-tag
    margin 0
    max-width 100%
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

// 图片能力芯片：只在"值得动手"时出现（判定为纯文本 / 通道不带图 / 带图但未识别）。
// 颜色一律走语义 token，双主题都跟；未识别刻意用最弱的一档，不要看着像报错
.ai-image-cap-chip
  display inline-flex
  align-items center
  gap 4px
  padding 1px 7px
  border-radius var(--radius-xs)
  border 1px solid var(--border)
  font-size 12px
  line-height 18px
  cursor pointer
  white-space nowrap
  .anticon
    font-size 12px
  &.is-unknown
    color var(--text-muted)
    background var(--surface-3)
  &.is-no
    color var(--warn)
    border-color var(--warn)
    background var(--warn-bg)
  &.is-transport
    color var(--error)
    border-color var(--error)
    background var(--error-bg)

.ai-image-blocked
  padding 6px 8px
  border 1px solid var(--warn)
  border-radius var(--radius-xs)
  background var(--warn-bg)
  .ai-image-blocked-text
    color var(--text-dark)
    font-size 12px

// 图片附件卡片：缩略图 + 名称 + 尺寸/体积 + 删除。文本附件仍是 Tag，两种附件
// 的信息密度差很多，硬塞进同一个 Tag 会把体积和尺寸挤掉
// 草稿区用 .ai-chat-attachments（文本 Tag 与图片卡片混排），历史区用
// .ai-image-attachments 包一层；卡片样式两边同一套，别只写一处
.ai-image-attachments,
.ai-chat-attachments
  .ai-image-card
    position relative
    display inline-flex
    align-items center
    gap 6px
    padding 4px 6px
    border 1px solid var(--border)
    border-radius var(--radius-xs)
    background var(--surface-3)
    max-width 100%
    .ai-image-thumb
      width 44px
      height 44px
      object-fit cover
      border-radius var(--radius-xs)
      cursor zoom-in
      background var(--surface-1)
    .ai-image-meta
      display flex
      flex-direction column
      min-width 0
    .ai-image-name
      max-width 150px
      overflow hidden
      white-space nowrap
      text-overflow ellipsis
      font-size 12px
      color var(--text-dark)
    .ai-image-size
      font-size 11px
      color var(--text-muted)
    .ai-image-remove
      cursor pointer
      color var(--text-muted)
      &:hover
        color var(--error)
    // 判定为纯文本/通道不带图时卡片描一遍警告色，光靠下面的横幅容易被忽略
    &.is-warn
      border-color var(--warn)
    // 重启后缩略图还在、原图没了：留灰态 + 明确文案，不要静默把图丢了
    &.is-expired
      opacity 0.6
      .ai-image-thumb
        cursor default
        filter grayscale(1)

.ai-chat-item-attachments
  .ant-tag
    margin-right 4px
    margin-bottom 4px

.ai-attachment-dragover
  outline 2px dashed var(--primary)
  outline-offset -2px

.ai-chat-sessions-wrap
  width 100%
  height 100%
  overflow-y auto
  overflow-x hidden
  padding 4px 0

.ai-chat-sessions-toolbar
  padding 0 4px 8px

.ai-chat-session-item
  display flex
  align-items center
  padding 8px 10px
  margin-bottom 6px
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  cursor pointer
  transition all 0.2s
  &:hover
    border-color var(--primary)
    background var(--main-dark)
    .ai-chat-session-delete
      opacity 1
  &.active
    border-color var(--primary)
    background rgba(24, 144, 255, 0.06)

.ai-chat-session-content
  flex 1
  min-width 0
  overflow hidden

.ai-chat-session-header
  margin-bottom 4px

.ai-chat-session-preview
  font-size 13px
  font-weight 500
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.ai-chat-session-meta
  font-size 12px
  color var(--text-dark)

.ai-chat-session-time
  flex-shrink 0

.ai-chat-session-count
  flex-shrink 0
  margin-left 8px

.ai-chat-session-delete
  opacity 0
  flex-shrink 0
  margin-left 8px
  transition opacity 0.2s

.ai-chat-sessions-empty
  height 100%
  min-height 200px

.ai-stop-icon-square
  width 20px
  height 20px
  border-radius var(--radius-xs)
  display flex
  align-items center
  justify-content center
  font-size 10px

.ai-history-item-title
  display flex
  align-items center
  .ai-stop-icon-square
    margin-left auto

.agent-tool-calls
  margin 8px 0

.agent-tool-call-card
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  margin-bottom 6px
  font-size 13px

.agent-tool-header
  display flex
  align-items center
  padding 6px 8px
  gap 6px

.agent-tool-name
  font-weight 500

.agent-tool-tag
  margin-left auto

.agent-tool-status-running
  color var(--primary)
  animation spin 1s linear infinite

.agent-tool-status-completed
  color var(--success)

.agent-tool-status-error
  color var(--error)

.agent-tool-detail
  padding 0 8px 8px
  border-top 1px solid var(--border)

.agent-tool-args
  margin-top 6px

.agent-tool-result
  margin-top 6px

.agent-tool-label
  font-weight 500
  margin-bottom 4px
  font-size 12px
  color var(--text-dark)

.agent-tool-pre-wrap
  position relative

.agent-tool-copy
  position absolute
  top 5px
  right 6px
  z-index 1

.agent-tool-pre
  background var(--main-dark)
  padding 6px 26px 6px 8px
  border-radius var(--radius-xs)
  font-size 12px
  max-height 200px
  overflow-y auto
  white-space pre-wrap
  word-break break-all
  margin-bottom 0

.agent-tool-running
  border-color var(--primary)

.agent-tool-completed
  border-color var(--success)

.agent-tool-error
  border-color var(--error)

@keyframes spin
  from
    transform rotate(0deg)
  to
    transform rotate(360deg)

.ai-chat-empty
  position relative
  width 100%
  min-height 150px
  display flex
  align-items center
  justify-content center
  overflow hidden
  padding 10px 0

.ai-chat-empty-inner
  text-align center
  padding 0 12px
  max-width 100%

.ai-chat-watermark
  width 86%
  max-width 400px
  aspect-ratio 766 / 266
  margin 0 auto 14px
  background-color var(--text)
  opacity 0.55
  pointer-events none
  user-select none
  -webkit-mask-image var(--ai-watermark)
  mask-image var(--ai-watermark)
  -webkit-mask-repeat no-repeat
  mask-repeat no-repeat
  -webkit-mask-position center
  mask-position center
  -webkit-mask-size contain
  mask-size contain

.ai-chat-empty-title
  font-size 15px
  font-weight 500

.ai-chat-empty-hint
  font-size 12px
  margin-top 4px
  color var(--text-dark)

.ai-chat-empty-examples
  margin-top 14px
  display flex
  flex-direction column
  align-items center
  gap 6px

.ai-chat-empty-example
  max-width 100%
  font-size 12px
  padding 5px 10px
  border 1px solid var(--border)
  border-radius var(--radius-lg)
  color var(--text-dark)
  cursor pointer
  transition all 0.2s
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  &:hover
    border-color var(--primary)
    color var(--text)

// context size indicator, right hand side of the ai chat toolbar
.ai-context-indicator
  display inline-flex
  align-items center
  gap 4px
  flex-shrink 0
  font-size 11px
  line-height 1
  color var(--text-dark)
  cursor default
  user-select none

.ai-context-bar
  display inline-block
  width 34px
  height 5px
  border-radius var(--radius-xs)
  background var(--main-darker)
  overflow hidden
  flex-shrink 0

.ai-context-bar-fill
  display block
  height 100%
  border-radius var(--radius-xs)
  background var(--primary)
  transition width 0.2s

.ai-context-count
  color var(--text-dark)
  font-variant-numeric tabular-nums

.ai-context-percent
  font-variant-numeric tabular-nums

.ai-context-warn
  .ai-context-bar-fill
    background var(--warn)
  .ai-context-percent
    color var(--warn)

.ai-context-danger
  .ai-context-bar-fill
    background var(--error)
  .ai-context-percent
    color var(--error)
    font-weight 500

.ai-context-tip
  font-size 12px
  min-width 210px

.ai-context-tip-title
  font-weight 500
  margin-bottom 4px

.ai-context-tip-row
  display flex
  justify-content space-between
  gap 12px

.ai-context-tip-total
  font-weight 500
  border-top 1px solid rgba(128, 128, 128, 0.35)
  margin-top 2px
  padding-top 2px

.ai-context-tip-note
  margin-top 4px
  opacity 0.75

.ai-context-tip-warn
  margin-top 4px
  color var(--warn)

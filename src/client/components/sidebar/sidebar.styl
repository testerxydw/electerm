
.animate-fast
  animation-duration var(--dur-2)
.sidebar-panel
  position absolute
  left 0
  top 0
  // 避让底部常显区（三合一后的单条 footer），否则面板底部内容被遮挡
  bottom var(--footer-stack-height, 36px)
  z-index 200
  width 0
  overflow-y scroll
  background var(--surface-1)
  .item-list-unit:hover
    .list-item-remove
      display none !important
.sidebar-panel
  // 对齐 tabs 栏 38px（tabs.styl）：面板永不盖标题栏（与右面板统一）
  top 38px
.sidebar
  position absolute
  left 0
  top 0
  // 用注入的宽度 token（原硬编码 36px，与 sidebarWidth=43 不一致 → 底部/面板 left 偏移 7px）
  width var(--left-side-bar-width, 50px)
  z-index 100
  // 同上：图标栏底部（设置/头像）不被底部单条 footer 遮挡
  bottom var(--footer-stack-height, 36px)
  background var(--surface-0)
  display flex
  flex-direction column

  .item-list
    padding-right 0
.sidebar-pin-top
  position absolute
  left 0
  right 0
  top 0
  height 112px
.sidebar-panel-bookmarks
.sidebar-panel-history
  position absolute
  left 0
  right 0
  top 112px
  bottom 0
  overflow hidden
  display flex
  flex-direction column
  .sidebar-inner
    flex 1
    display flex
    flex-direction column
    overflow hidden
    min-height 0
  .history-header
    flex-shrink 0
    display flex
    align-items center
    border-bottom 1px solid var(--border)
    position sticky
    top 0
    z-index 10
    background var(--main)
    .history-sort
      display flex
      align-items center
      gap 6px
    .history-sort-label
      user-select none
    .history-clear-icon
      margin-left auto
      margin-right 0
      color var(--text-dark)
      transition color var(--dur-1) var(--ease)
      &:hover
        color var(--error)
  .history-body
    flex 1
    overflow-y auto
    overflow-x hidden
.not-system-ui.is-mac
  .sidebar-bar
    margin-top 20px
.type-bookmarks
  .bookmarks-panel
    width 100%
.type-history
  .history-panel
    width 100%
.control-icon-text
  color var(--text)
  transition color var(--dur-1) var(--ease)
  &:hover
    color var(--success)
.control-icon-wrap
  padding 14px 0
  text-align center
  &.active
    .control-icon
      color var(--text)
      background var(--active-bg)
      box-shadow inset 2px 0 0 0 var(--primary)
  .control-icon
    color var(--text-dark)
    cursor pointer
    border-radius var(--radius-xs)
    transition color var(--dur-1) var(--ease), background var(--dur-1) var(--ease)
    &:hover
      color var(--text-light)
      background var(--hover-bg)

// 左图标栏（草图所述 rail）：按钮应为 36×36 圆角方块。
// 原实现 padding 14px 0 → 背景/圆角贴在图标本体上、且栏宽(36)与 token(43) 不一致。
// 限定在 .sidebar-bar 内，避免影响 transfer / upgrade 等其它 .control-icon-wrap 用法。
.sidebar-bar
  .control-icon-wrap
    width 36px
    height 36px
    margin 2px auto
    padding 0
    display flex
    align-items center
    justify-content center
    border-radius var(--radius)
    position relative
    transition background var(--dur-1) var(--ease)
    &:hover
      background var(--hover-bg)
    // 选中态：品牌着色 + 左侧 3px 色条（对齐草图 .ri.on）
    &.active
      background var(--active-bg)
      &::before
        content ''
        position absolute
        left -7px
        top 9px
        bottom 9px
        width 3px
        border-radius 0 3px 3px 0
        background var(--primary)
      .control-icon
        color var(--text)
        background transparent
        box-shadow none
    .control-icon
      color var(--text-dark)
      background transparent
      box-shadow none
      cursor pointer
      transition color var(--dur-1) var(--ease)
    &:hover .control-icon
      color var(--text-light)
.sidebar-list
  position absolute
  left var(--left-side-bar-width, 43px)
  top 0
  bottom 0
  z-index 200
  width 0
  // 面板可见即挤压终端（layout.jsx），常驻列与右面板一致，拖拽把手常显
  .drag-handle
    display block

// icon bar: fills sidebar height, scrolls when overflow on small screens,
// scrollbar hidden but scrolling still works
.sidebar-bar
  flex 1
  min-height 0
  overflow-y auto
  overflow-x hidden
  scrollbar-width none // Firefox
  -ms-overflow-style none // IE/Edge
  // 纵向 flex，便于底部头像用 margin-top:auto 吸底（对齐草图 .rail）
  display flex
  flex-direction column
  align-items center
  &::-webkit-scrollbar
    width 0
    height 0
    display none

// 底部头像（对齐重设计草图 .rail .av）
.sidebar-avatar
  flex none
  margin-top auto
  margin-bottom 8px
  width 30px
  height 30px
  display flex
  align-items center
  justify-content center
  border-radius 50%
  font-size 11px
  font-weight 700
  color var(--primary-contrast)
  cursor pointer
  transition box-shadow var(--dur-1) var(--ease)
  background unquote('linear-gradient(135deg, var(--primary), color-mix(in srgb, var(--primary) 50%, var(--info)))')
  &:hover
    box-shadow 0 0 0 2px var(--active-bg)

// 面板头（对齐草图 .panel-hd：11px / --text-dark / 大写间距）
.sidebar-panel-tabs
  display flex
  align-items center
  gap 8px
  .ant-tabs-nav
    margin 0
  .ant-tabs-tab
    font-size 11px
    padding 4px 0
.sidebar-panel-title
  flex none
  font-size 11px
  letter-spacing .4px
  text-transform uppercase
  color var(--text-dark)

// 头像账户菜单（对齐草图：头像点击 → 账户菜单）
.sidebar-avatar-menu
  min-width 120px
.sidebar-avatar-menu-item
  padding 6px 12px
  font-size 12px
  color var(--text)
  cursor pointer
  white-space nowrap
  border-radius var(--radius-xs)
  transition background var(--dur-1) var(--ease)
  &:hover
    background var(--hover-bg)
    color var(--text)

// mobile: icon bar hidden — hide its buttons
.sidebar.collapsed
  .sidebar-bar
    display none

// pin 仅保留"点击外部不关闭"行为差异（sidebar.js handleClickOutside），
// 不再有贴顶停靠样式：面板两种状态都从 38px 标题栏下开始（.sidebar-panel）
.pinned
  .sidebar-panel
    .pinned
      color var(--success)
//btns
.btns
  background var(--surface-0)
  border-color var(--primary)
  .open-about-icon
    color var(--text-dark)
    &:hover
      color var(--text-light)
  .zoom-reset-icon
    color var(--primary)
    &:hover
      color var(--text-light)

.btns .upgrade-icon
  color var(--success)
.close-info-modal
  cursor pointer
  &:hover
    color var(--text-light)
.logo-filter
  filter invert(80%)
.sidebar-inner
  padding-right 8px
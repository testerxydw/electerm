// 底部状态栏（26px）——全 token 化

.main-statusbar
  position absolute
  left calc(var(--left-side-bar-width, 43px) + 1px)
  right 0
  bottom 0
  height 26px
  z-index 210
  display flex
  align-items center
  gap 14px
  padding 0 12px
  font-size 11px
  color var(--text-dark)
  background var(--surface-0)
  box-shadow inset 0 1px 0 0 var(--border)

.pinned
  .main-statusbar
    left 343px

.statusbar-unit
  display inline-flex
  align-items center
  gap 6px
  white-space nowrap

.statusbar-grow
  flex 1

.statusbar-hint
  color var(--text-disabled)

.statusbar-dot
  width 6px
  height 6px
  border-radius var(--radius-pill)
  background var(--text-disabled)
  &.ok
    background var(--success)
  &.err
    background var(--error)

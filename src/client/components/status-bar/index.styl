// 底部状态栏（26px）——全 token 化

.main-statusbar
  position absolute
  left calc(var(--left-side-bar-width, 50px) + 1px)
  right 0
  bottom 0
  height 26px
  z-index 210
  display flex
  align-items center
  gap 14px
  padding 0 12px
  font-size 11px
  // 对齐草图 .statusbar：等宽字体（项目变量名为 --font-mono）
  font-family var(--font-mono)
  color var(--text-dark)
  background var(--surface-0)
  box-shadow inset 0 1px 0 0 var(--border)

// 主机名加粗（草图 .statusbar .it b）
.statusbar-host
  color var(--text)
  font-weight 600

// 命令面板提示里的按键（草图 .statusbar kbd 风格）
.statusbar-hint
  kbd
    font-family var(--font-mono)
    font-size 10px
    border 1px solid var(--border)
    border-radius var(--radius-xs)
    padding 0 4px
    color var(--text-dark)

.pinned
  .main-statusbar
    left 343px

.statusbar-unit
  display inline-flex
  align-items center
  gap 6px
  white-space nowrap

.statusbar-grow
  flex 1

.statusbar-hint
  color var(--text-disabled)

.statusbar-dot
  width 6px
  height 6px
  border-radius var(--radius-pill)
  background var(--text-disabled)
  &.ok
    background var(--success)
  &.err
    background var(--error)

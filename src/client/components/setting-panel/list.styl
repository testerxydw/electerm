
.item-list-wrap
  overflow-y scroll
  &::-webkit-scrollbar
    width 0
.list-item-edit
.list-item-apply
.list-item-remove
.list-item-bookmark
.list-item-duplicate
.list-item-autorun
  display none
  width 24px
  line-height 35px
  text-align center
  position absolute
  right 0
  top 0
.list-item-autorun
  right 24px

.list-item-title
  flex-grow: 1
.item-list-unit
  display flex
  position relative
  margin-bottom 1px
  cursor pointer
  line-height 1.8
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &.active
    background var(--active-bg)
    color var(--text)
  &.current
    font-weight bold
  &:hover
    background var(--hover-bg)
    color var(--text)
    .list-item-apply
    .list-item-edit
    .list-item-remove
    .list-item-bookmark
    .list-item-duplicate
    .list-item-autorun
      display block
.theme-item:hover
    .list-item-remove
      right 24px
// touch screens have no hover — always reveal the hover-only action icons
.is-touch-device
  .list-item-edit
  .list-item-apply
  .list-item-remove
  .list-item-bookmark
  .list-item-duplicate
  .list-item-autorun
    display block
  .theme-item
    .list-item-remove
      right 24px
.setting-tabs-setting
  .item-list-unit
    .list-item-remove
      display none
// .item-list
//   .list-item-edit
//   .list-item-apply
//     right 20px
.item-list-unit
  .list-item-bookmark
    right 18px
  .list-item-duplicate
    right 24px
// P-3（2026-11-04 拍板"只做连接状态点"）：历史行的连接状态点。
// 槽位常驻、点按需画 —— 只有"这台目标当前有开着的会话"才亮，且槽位宽度不变，
// 否则同一列里有点/没点的行首文字会错开一格（书签树那颗点是行内前缀，
// 那里本来就有缩进层次，历史列表是平铺的，不能照抄）。
// 尺寸 7px 与页签条 .tab-status 同口径；颜色只吃 token（success/primary/error），
// 不加光晕也不呼吸：这列一次能排十几行，动效太多反而看不出哪条是"开着的那条"。
.history-status-slot
  flex 0 0 auto
  width 12px
  display flex
  align-items center
  justify-content center
.history-status-dot
  width 7px
  height 7px
  border-radius var(--radius-pill)
  background-color var(--text-dark)
  &.success
    background-color var(--success)
  &.processing
    background-color var(--primary)
  &.error
    background-color var(--error)

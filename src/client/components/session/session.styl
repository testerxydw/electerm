@keyframes rotate
  from
    background-position -3000px
  to
    background-position 0px
.type-tab-line
  position absolute
  bottom 0
  left 0
  width 100%
  height 1px
  background var(--primary)
  display none
.type-tab-txt
  position relative
  display inline-block

.type-tab
  display inline-block
  vertical-align middle
  line-height 30px
  padding 0 20px 0 0
  margin-right 0px
  font-size 14px
  cursor pointer
  transition color var(--dur-1) var(--ease)
  &:hover
  &.active
    color var(--text-light)
  &.active
    .type-tab-line
      display inline-block

.is-transporting
  .type-tab.sftp
    .type-tab-line
      display inline-block
      background linear-gradient(to right, var(--success) 0%, var(--main) 25%, var(--error) 50%, var(--primary) 75%, var(--success) 100%)
      animation: rotate 60s infinite linear
.disable-ssh
  .type-tab.ssh
    display none
.spliter
  color var(--text)
  &:hover
    color var(--text-light)

.sessions
  position absolute
  background var(--main)
.session-wrap
  display none
  // 竖向 flex 容器：页根自己声明"顶栏 flex none / 内容 flex 1"，
  // 内容区可用高由浏览器分配，不再靠 JS 扣减（T3/T4）
  flex-direction column
  position absolute
  overflow hidden
  z-index 3
  // 让位顶部标签栏；与 JS 扣减镜像见 tokens.styl --tabs-bar-h（init-state tabsHeight）
  padding-top var(--tabs-bar-h)
  box-shadow var(--shadow-1)
  > *
    flex 1 1 0
    min-height 0
  &.session-batch-active
    display flex

.term-sftp-box
  // 竖向 flex：顶栏 flex none，终端/SFTP 内容吃满剩余高度。全屏时外层
  // .session-wrap 是 fixed 100%，分栏随 flex 铺满 —— 不再依赖 JS 给的 px 高
  display flex
  flex-direction column
  min-height 0
  > .ant-splitter
    flex 1 1 0
    min-height 0
    height auto
// SFTP 单页/分栏的直系容器：高度由 Splitter 面板决定，内部交给 .sftp-wrap
.sftp-pane-wrap
  display flex
  flex-direction column
  height 100%
  min-height 0
// 终端内容区：非分栏时吃满竖向剩余高；分栏时尺寸由 Splitter 面板决定。
// .term-wrap 定位 inset 0，所以 .terms-box 必须有实际尺寸（不再由 JS 给 px）
.term-sftp-box > .terms-box
  flex 1 1 0
  min-height 0
.term-sftp-box .ant-splitter-panel > .terms-box
  height 100%
// 数据库页定高容器（与终端内容区同高）：内容 100% 填充，避免底部伸到底栏之下
.db-session-box
  overflow hidden
.web-session-wrap
  height 100%
  background var(--main)
  overflow hidden
  display flex
  flex-direction column
.web-session-content
  flex 1
  min-height 0
  overflow hidden

.not-split-view > .ant-splitter-bar .ant-splitter-bar-dragger
  display none

.sess-icon
  margin-right 10px
  &.active
    color var(--warn)

.wrap-toggle-icon
.split-view-toggle
  &.active
    color var(--success)

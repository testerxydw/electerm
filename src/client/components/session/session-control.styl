// Mobile session control: pane tabs always visible,
// other icons shown in a floating Popover overlay
.mobile-session-control
  background var(--main)
  line-height 32px
  padding 0 10px
  display flex
  align-items center
  // pane tabs take available space, menu icon sits at the end
  .term-sftp-tabs
    float none
    display flex
    align-items center
    flex 1
    min-width 0
.mobile-control-toggle
.mobile-context-menu-toggle
  font-size 16px
  line-height 32px
  color var(--text)
  flex-shrink 0
  transition color var(--dur-1) var(--ease)
  &:hover
    color var(--text-light)

// touch-only terminal context menu icon, in the bar next to the toggle above
.mobile-context-menu-toggle
  margin-right 10px

// Popover content — icons laid out in a row, wrapping as needed
.mobile-control-icons
  display flex
  flex-wrap wrap
  align-items center
  gap 4px 8px
  max-width 280px
  line-height 30px
  .term-controls
    float none
    display flex
    align-items center
    margin-left 0
  // 连接信息（内容区顶部面包屑）
.session-conn-info
  display inline-flex
  align-items center
  gap 6px
  margin-right 12px
  max-width 220px
  color var(--text-dark)
  font-size 12px
  // 主机名加粗（草图 .crumb .host）
  .conn-host
    max-width 180px
    color var(--text)
    font-weight 600
  // 状态胶囊（草图 .crumb .badge：ok 底 + 绿边 / err 底 + 红边）
  .conn-badge
    flex none
    font-family var(--font-mono)
    font-size 10px
    line-height 16px
    border-radius var(--radius-pill)
    padding 1px 8px
    border 1px solid var(--border)
    color var(--text-dark)
    &.ok
      background unquote('color-mix(in srgb, var(--success) 15%, var(--main))')
      border-color unquote('color-mix(in srgb, var(--success) 40%, transparent)')
      color unquote('color-mix(in srgb, var(--success) 75%, var(--text))')
    &.err
      background unquote('color-mix(in srgb, var(--error) 15%, var(--main))')
      border-color unquote('color-mix(in srgb, var(--error) 40%, transparent)')
      color unquote('color-mix(in srgb, var(--error) 78%, var(--text))')
  .conn-dot
    width 6px
    height 6px
    flex none
    border-radius var(--radius-pill)
    background var(--text-disabled)
    &.ok
      background var(--success)
    &.err
      background var(--error)

.sess-icon
    margin-right 0

// T5-2d 会话信息三段（ssh2 算法 / zsh 版本 / ↑↓ 速率），前部灯态开关
// (T5-4d 布局调整: fright → fleft, 紧跟 终端/SFTP 切换 tab 靠前排布)
.session-bar-status
  display inline-flex
  align-items center
  margin-left 4px
  margin-right 8px
  min-width 0
  .session-bar-status-segs
    display inline-flex
    align-items center
    min-width 0
    overflow hidden
  .session-bar-seg
    display inline-flex
    align-items center
    gap 4px
    padding 0 10px
    white-space nowrap
    font-size 11px
    overflow hidden
    text-overflow ellipsis
    & + .session-bar-seg
      border-left 1px solid var(--border)
    .seg-k
      color var(--text-dark)
    .seg-v
      color var(--text)
      overflow hidden
      text-overflow ellipsis
    .seg-up
      color var(--success)
      font-weight 600
    .seg-down
      color var(--primary)
      font-weight 600
  .session-bar-status-toggle
    flex none
    transition color var(--dur-2) var(--ease)
    &.active
      color var(--primary)

// 查找入口激活态：展开查找条时染主色（与数据库页 .db-search-on 同口径）
.search-open
  color var(--primary)

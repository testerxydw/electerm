.db-session-wrap
  display flex
  flex-direction column
  height 100%
  width 100%
  overflow hidden
  // S6：数据面禁连字，防 0/O、l/1、=>/≠ 等视觉混淆（对非数据面文本无副作用）
  font-variant-ligatures none

// 顶部工具条：引擎/目标/状态 + 只读/刷新。
// 高度口径 = tokens.styl --session-bar-h（与 .terminal-control 统一；
// session/sessions.jsx 的扣减依赖该值，JS 侧镜像见 constants.js termControlHeight）
.db-head
  flex none
  height var(--session-bar-h)
  display flex
  align-items center
  gap 8px
  padding 0 10px
  border-bottom 1px solid var(--border)
  font-size 12px

.db-head-engine
  flex none
  padding 0 6px
  border-radius var(--radius-sm)
  background var(--hover-bg)
  line-height 18px

.db-head-target
  min-width 0
  color var(--text-dark)

.db-head-state
  flex none
  display flex
  align-items center
  gap 4px
  color var(--text-dark)

.db-head-dot
  width 6px
  height 6px
  border-radius var(--radius-pill)
  background var(--success)
  &.err
    background var(--error)

// 只读/刷新紧跟在连接信息之后（左起排列），不推到工具条最右端
.db-head-right
  display flex
  align-items center
  gap 6px

// 窗口级动作（查找/全屏）：靠右，与终端顶栏 SessionControl 右侧控件同位置同口径
// （S1 起图标本体来自 common/session-bar-actions.jsx，激活态类 .search-open 全局共用）
.db-head-actions
  margin-left auto
  display flex
  align-items center
  gap 6px
  color var(--text-dark)

// 查找命中标记：非当前 = 弱化品牌色；当前 = 主色 + 外描边（颜色走 token：CSS 契约禁止裸色值）
.db-kw-hit
  background var(--accent-wash)
  color var(--text)
  &.db-kw-cur
    background var(--primary)
    color var(--primary-contrast)
    outline 1px solid var(--primary-contrast)
  border-radius var(--radius-xs)

// T1/T2 局部过滤命中：独立 class，避免被顶栏查找的计数与导航误收
.db-page-hit
  background var(--accent-wash)
  color var(--text)
  border-radius var(--radius-xs)
.db-tree-hit
  background var(--accent-wash)
  color var(--text)
  border-radius var(--radius-xs)

// 左右分栏容器（树 | 拖拽条 | 主区）：原 .db-session-wrap 的内边距搬到这里
.db-body
  flex 1 1 0
  min-height 0
  display flex
  flex-direction row
  padding 8px
  gap 8px
  overflow hidden

// 错误态：不沿用 .db-session-wrap 的 flex 行布局，避免 Alert 被拉伸满屏
.db-session-error
  display block
  padding 12px

.db-session-loading
  display flex
  align-items center
  gap 8px
  min-height 200px

.db-session-loading-text
  color var(--text)

// 左侧元数据树
.db-tree-panel
  flex none
  // 宽度由内联样式驱动（可拖拽调整，见 .db-tree-resizer），此处只约束范围
  min-width 160px
  max-width 600px
  height 100%
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  padding 4px
  // 容器是圆角、全局滚动条 thumb 是直角，滚动到两端时与圆角相切/被裁；
  // 这里让 thumb 也圆角，并用 1px 透明边框 + content-box 裁切使其内缩，避免贴角
  &::-webkit-scrollbar-thumb
    border-radius var(--radius-xs)
    border 1px solid transparent
    background-clip content-box

// T2 树过滤：占树面板顶部一行，不改变面板高度
.db-tree-filter
  margin-bottom 6px

.db-tree-filter-count
  color var(--text-dark)
  font-size 12px
  margin 0 2px 6px
  white-space nowrap
  font-variant-numeric tabular-nums

// 拖拽条：命中区骑跨在左侧容器右边框上，因此"拖的就是容器边缘"，
// 而不是浮在面板与主区之间的独立竖条。
// 定位算术：margin-left = -(gap 8 + 半宽 4) = -12 → 左边缘落在边框左 4px；
// margin-right = +12 补回，净占位仍是 9px，故右侧主区位置与改动前完全一致。
.db-tree-resizer
  flex none
  position relative
  z-index 5
  width 9px
  margin 0 12px 0 -12px
  cursor col-resize
  background transparent
  &::after
    content ''
    position absolute
    top 0
    bottom 0
    left 4px
    width 1px
    background transparent
    transition background var(--dur-1) var(--ease)
  &:hover::after
    background var(--primary)
  &:active::after
    background var(--primary)

// Redis 数据库节点：名称居左、键个数居右
.db-tree-db
  display flex
  align-items center
  justify-content space-between
  gap 8px
  width 100%

.db-tree-db-count
  color var(--text-dark)
  font-size 12px
  font-variant-numeric tabular-nums

// mysql 元数据 per-db 降级标记（单库 SHOW TABLES 失败，悬停见错误详情）
.db-tree-db-err
  color var(--error)
  margin-left 5px
  font-weight bold

// 工具条"系统库"显示开关（label + Switch）
.db-sys-toggle
  display inline-flex
  align-items center
  margin-right 8px
.db-sys-toggle-label
  color var(--text-dark)
  font-size 12px
  margin-right 4px
  white-space nowrap

// 右侧主区
.db-main-panel
  flex 1 1 0
  min-width 0
  height 100%
  display flex
  flex-direction column
  overflow hidden

.db-grid-area
  display flex
  flex-direction column
  height 100%
  overflow hidden

// 表名 + 行数估算 + 翻页 + 刷新：一条左对齐的控制条（与 Redis 的 .db-redis-bar 同款），
// 不用 space-between 把控件摊到整行两端
.db-grid-head
  display flex
  align-items center
  gap 8px
  padding 0 4px 8px
  min-width 0

.db-grid-title
  color var(--text)
  font-weight 500
  // 表名过长时截断，不挤走后面的控件
  max-width 45%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-grid-pager
  display flex
  align-items center
  gap 8px

.db-grid-page-no
  color var(--text)

// 页码快速跳转标签（当前页 ±1 + 首/末页 + 省略号）
.db-grid-page-tags
  display flex
  align-items center
  gap 4px

// 跳页输入
.db-grid-jump
  width 72px

// 近似总行数（次要信息）
.db-grid-total
  color var(--text-dark)
  font-size 12px
  display inline-flex
  align-items center
  gap 4px

// T11 精确总行数：文字按钮与 exact 标记
.db-exact-btn
  padding 0
  height auto
  font-size 12px
.db-exact-tag
  margin 0
  padding 0 3px
  font-size 10px
  line-height 14px
  border-radius var(--radius-xs)

// B1 插入行弹窗：列名(含 PK/自增标记) + 输入框 + NULL 勾选，一行一列
.db-insert-form
  display flex
  flex-direction column
  gap 8px
  max-height 60vh
  overflow-y auto
  padding-right 4px
.db-insert-row
  display flex
  align-items center
  gap 8px
.db-insert-col
  flex 0 0 38%
  display inline-flex
  align-items center
  gap 4px
  min-width 0
.db-insert-col-name
  color var(--text)
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
.db-insert-col-type
  flex 0 0 auto
  color var(--text-dark)
  font-size 11px
.db-insert-row .ant-input
  flex 1 1 auto
  min-width 0

// A2 结构 tab 工具行 + DDL 弹窗等宽展示
.db-struct-tools
  display flex
  gap 8px
  margin-bottom 8px
.db-ddl-pre
  margin 0
  max-height 60vh
  overflow auto
  padding 10px
  border-radius var(--radius-sm)
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  white-space pre
  color var(--text)

// T4 PG 跨库连接入口与确认弹窗
.db-tree-connect
  margin-left 6px
  padding 0
  height auto
  font-size 12px
.db-connect-rows
  display flex
  flex-direction column
  gap 6px
  margin-bottom 12px
.db-connect-row
  display flex
  gap 8px
.db-connect-row > span:first-child
  width 72px
  color var(--text-dark)

// PG 树 schema 节点：S 标记与名称同排
.db-tree-schema
  display inline-flex
  align-items center
  gap 4px
.db-tree-schema-mark
  padding 0 3px
  border 1px solid var(--border)
  border-radius var(--radius-xs)
  color var(--text-dark)
  font-size 10px
  line-height 14px

// F0：视图叶子节点的 V 标记（与 .db-tree-schema-mark 同一套视觉语言：
// 小方块 + 单字母）。视图在树里与表同名同形，没有标记就分不出来
// 关键：不能用 inline-flex 包文字。实测 inline-flex 会把树行从 24px 撑到 25px
// （baseline 对齐留 descent），加 vertical-align:middle 更是到 26px——
// 整棵树的行高必须严格一致，否则滚动时行会一高一低地抖
.db-tree-view
  display inline

.db-tree-view-mark
  display inline-block
  margin-right 4px
  padding 0 3px
  border 1px solid var(--border)
  border-radius var(--radius-xs)
  color var(--text-dark)
  font-size 10px
  line-height 14px
  vertical-align text-bottom

// PG 表结构主键徽标（列定义网格）
.db-pk-tag
  margin 0
  padding 0 4px
  font-size 11px
  line-height 16px
  border-radius var(--radius-xs)

// T1 当前页过滤：窄窗口允许收缩，不把网格头挤成两行
.db-page-filter
  width 132px
  flex 0 1 132px
  min-width 96px

.db-page-filter-count
  color var(--text-dark)
  font-size 12px
  white-space nowrap
  font-variant-numeric tabular-nums

// 取数失败：错误落在表格区内（不再只 toast）
.db-grid-error
  flex none
  margin-bottom 8px

// 空表提示
.db-empty-tip
  color var(--text-dark)

// 主数据网格滚动容器（仅数据 tab 的表格用）：
// 滚动权交给 antd 内部表体（scroll.y 定高），横向滚动条常驻可视区底边、表头吸顶
// （见 doc/已完成/数据库功能设计归档-2026-10-21.md）；其余 Table（SQL 结果/表结构/Redis）仍走 .db-grid-table 旧滚动
.db-grid-table-wrap
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.db-grid-table
  // basis 用 auto 而非 0：wrap 定高（主网格等）时效果相同，
  // 但在 auto 高度的 wrap 里（如 .db-redis-keys 的 max-height 45%）不会把内容高缩成 0
  flex 1 1 auto
  min-height 0
  overflow auto
  // S6：网格单元格数据面字体与终端统一
  font-family var(--db-code-font, var(--font-mono))

// B1 行选择列：scroll.y 生效后表头/表体是两个独立 table，列宽由 colgroup 决定，
// 而 colgroup 的宽度来自 antd rowSelection.columnWidth（见 db-session.jsx SEL_COL_W）。
// 这里只管盒模型：同宽 + 内边距，保证 16px 勾选框左右各留 10px 不被贴边裁切。
// ⚠️ 只靠 CSS 给宽度不够：列宽总和超容器时，表头那套 table 会把该列压成 1px
.db-grid-table .ant-table-selection-column
  width 36px
  min-width 36px
  padding-left 10px
  padding-right 10px

.db-cell-null
  color var(--text)
  opacity 0.5

// 关键字高亮（.db-kw）颜色由终端主题决定，在 db-highlight.jsx 里以内联 style 上色，
// 这里不再写死色值（CSS 契约：非 includes 目录禁止硬编码颜色）

// 可编辑单元格（非只读且有主键）：hover 细线提示"可双击编辑"
// 作用在 td 上（onCell），因此整格留白也是双击命中区
// 用 outline 而非 box-shadow：CSS 契约禁止 box-shadow 里的 px 字面量
.db-cell-editable
  cursor text
  &:hover
    outline 1px solid var(--primary)
    outline-offset -1px
  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset -2px

.db-cell-editor
  width 100%

// 值预览（原文 / 格式化都走这里）：等宽、可滚动、可选中复制，内容已按关键字高亮
.db-value-pre
  flex 1 1 auto
  min-height 0
  margin 0
  padding 6px 8px
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  background var(--main)
  color var(--text)
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  line-height 1.5
  white-space pre-wrap
  word-break break-all
  user-select text

// 主区 Tabs：antd6 的内容层级为 body-holder > body > content，逐层撑满
// （.db-sql-results-tabs 是 SQL 多结果集分栏，同一撑满链路）
.db-tabs, .db-sql-results-tabs
  height 100%
  display flex
  flex-direction column
  &.ant-tabs
    > .ant-tabs-nav
      margin 0 0 8px
    > .ant-tabs-body-holder
      flex 1 1 0
      min-height 0
      overflow hidden
      > .ant-tabs-body
        height 100%
        > .ant-tabs-content
          height 100%

// SQL 编辑器区
.db-sql-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

// A-1：CM6 外壳容器。边框/圆角/尺寸由编辑器主题（db-sql-editor.jsx）给出，
// 这里只管它在 flex 列里的行为，以及懒加载骨架屏的占位尺寸。
.db-sql-editor
  flex none
  font-family var(--db-code-font, var(--font-mono))
  overflow hidden

// 骨架屏：与编辑器同尺寸同边框，chunk 到位后替换不产生跳动
.db-sql-editor-skeleton
  min-height 96px
  max-height 260px
  border 1px solid var(--main-light)
  border-radius var(--radius-xs)

.db-sql-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-sql-result
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px
  // 结果外层的 antd Spin 包装层必须参与 flex 传高，
  // 否则内部 .db-grid-table-wrap 拿不到确定高度（scroll.y 不生效）
  > .ant-spin-nested-loading,
  > .ant-spin
    flex 1 1 0
    min-height 0
    display flex
    flex-direction column
    > .ant-spin-container
      flex 1 1 0
      min-height 0
      display flex
      flex-direction column

.db-sql-affected
  color var(--text)
  flex none

// Redis 键空间
.db-redis-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-redis-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-match
  flex 1 1 0
  min-width 120px
  max-width 360px

// 键列表/详情各 flex 1 1 0，具体比例由内联 flexBasis 驱动（可拖拽，默认平分）。
// ⚠️ 不能给固定 max-height：auto 高度 + 内部 basis 0 会把网格塌成 0（踩过）；
// 且固定比例无法适配键库规模差异
.db-redis-keys
  min-height 0
  // S6：键列表数据面字体与终端统一
  font-family var(--db-code-font, var(--font-mono))

// 上下可拖拽分区（redis 键列表/详情、mysql 网格/单元格预览共用，DbSplitPane）
.db-split-pane
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.db-split-pane-top
.db-split-pane-bottom
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.db-split-resizer
  flex none
  position relative
  z-index 5
  height 9px
  cursor row-resize
  background transparent
  &::after
    content ''
    position absolute
    left 0
    right 0
    top 4px
    height 1px
    background transparent
    transition background var(--dur-1) var(--ease)
  &:hover::after
    background var(--primary)
  &:active::after
    background var(--primary)

// 分区空态占位（未选键/未选单元格）
.db-pane-empty
  align-items center
  justify-content center

.db-row-selected td
  background var(--active-bg)

// 统一值预览/编辑面板（mysql 单元格、redis 键值共用，DbValuePane）
.db-value-pane
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  .db-value-pane-head
    display flex
    align-items center
    gap 8px
    padding 4px 8px
    flex none
  .db-value-pane-text
    flex 1 1 0
    min-height 0
    margin 0 8px 8px
    font-family var(--db-code-font, var(--font-mono))
    font-size 12px

.db-value-pane-pre
  margin 0 8px 8px

.db-redis-detail
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px

// 未选键时的占位：Empty 在半区内居中
.db-redis-detail-empty
  align-items center
  justify-content center

.db-redis-more
  flex none
  align-self flex-start

.db-redis-detail-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-key-name
  max-width 40%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// 表结构区（列定义网格）：撑满 tabpane（块级父级里 flex-basis 不生效，必须 height 100%），
// flex 列布局让 .db-grid-table-wrap 拿到确定高度并内部滚动
.db-struct-area
  height 100%
  min-height 0
  display flex
  flex-direction column
  overflow hidden

// 连接失败卡片：标题 + 目标 + 原因 + 原始错误 + 重连/复制
// （页面级：初次建连失败；区级 banner：操作中掉线）
.db-conn-fail
  max-width 560px
  padding 12px 14px
  border-radius var(--radius-sm)
  background var(--error-bg)
  box-shadow inset 3px 0 0 0 var(--error)
  color var(--text)

.db-conn-fail-banner
  flex none
  max-width none
  margin-bottom 8px

.db-conn-fail-head
  display flex
  align-items center
  gap 6px
  margin-bottom 8px
  color var(--error)
  font-weight 500

.db-conn-fail-row
  display flex
  gap 8px

.db-conn-fail-key
  flex none
  min-width 52px
  opacity .65

.db-conn-fail-val
  word-break break-all

// 原始错误：等宽 + 可滚动，方便复制给同事/工单，但不抢主信息
.db-conn-fail-raw
  margin 8px 0
  padding 6px 8px
  border-radius var(--radius-xs)
  background unquote('color-mix(in srgb, var(--main) 55%, transparent)')
  color var(--text-dark)
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  max-height 96px
  overflow auto
  word-break break-all

.db-conn-fail-actions
  display flex

// 多结果集：每个结果集一块（含 affected 行 + 网格）
// flex 撑满：让内部 .db-grid-table-wrap 拿到确定高度（scroll.y 生效的前提）
//
// height 100% 不是冗余：多结果集时本节点的父级是 Tabs 的 pane
// （.ant-tabs-content，display block），flex-grow 在非 flex 容器里完全不生效
// → 节点高度退化为「内容高」，而 .db-grid-table-wrap 是 flex 1 1 0 + overflow hidden，
// 在 auto 高度父级下主尺寸塌成 0 → 表格被整块裁掉（tools 行还看得见，
// 所以现象是「有下载按钮、没有表格」）。实测 pane 354px 时 wrap 为 0。
// 单结果集时父级是 .db-sql-result（flex column），flex 属性生效、height 被 flex-basis 覆盖，
// 两条路径互不干扰。
// 注意不要改成给 pane 加 display flex：antd 用 .ant-tabs-content-hidden 的
// display none 隐藏非激活面板，特异性低于本文件的选择器，会被一起覆盖掉。
.db-sql-result-one
  display flex
  flex-direction column
  gap 4px
  flex 1 1 0
  min-height 0
  height 100%

.db-sql-results-tabs
  flex 1 1 0
  min-height 0

// S3-B：SQL 结果导出工具行（右上角，不挤压网格）
.db-sql-result-tools
  display flex
  justify-content flex-end
  min-height 24px

// S3-C：SQL 执行历史弹层
// 尺寸由 JS 内联给（可拖拽 + 持久化），这里的 width/height 只是"JS 没给值"时的兜底
.db-history-pop
  width 720px
  height 440px
  display flex
  flex-direction column
  position relative
  min-width 0
  min-height 0

.db-history-head
  display flex
  align-items center
  justify-content space-between
  padding 0 4px 6px
  border-bottom 1px solid var(--border)
  font-weight 500

.db-history-title
  display flex
  align-items center
  gap 6px

.db-history-count
  padding 0 5px
  border-radius var(--radius-xs)
  background var(--hover-bg)
  color var(--text-dark)
  font-size 11px
  font-weight 400

// 筛选框：与列表同宽，右侧同样让出 6px 给拖拽把手
.db-history-filter
  flex 0 0 auto
  margin 6px 6px 0 0

// 列表 + 预览两栏：够宽左右排，窄了改上下（< 600px 时两栏各自都会被折到不可读）
.db-history-body
  display flex
  flex 1 1 auto
  // 右侧让出 6px：拖拽把手贴在弹层右边缘，不能压住列表滚动条
  padding-right 6px
  min-height 0
  gap 8px

.db-history-pop[data-split='col'] .db-history-body
  flex-direction column

.db-history-list
  // 容器高度由内联 style 钉死（不再靠 max-height），basis 0 才不会塌——
  // 老写法 flex 0 1 auto 是给"仅 max-height"的容器用的，现在反而会让列表
  // 按内容撑高把预览栏挤出去
  flex 1 1 0
  min-height 0
  overflow-y auto
  outline none
  &:focus-visible
    outline 1px solid var(--primary)
    outline-offset -1px

.db-history-item
  position relative
  padding 6px 8px 6px 6px
  border-left 2px solid transparent
  border-radius var(--radius-sm)
  cursor pointer
  &:hover
    background var(--hover-bg)
  &.is-active
    background var(--hover-bg)
    border-left-color var(--primary)
  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset -2px

// 列表里只露两行：一条语句可能几十行，全展开会把列表挤没；
// 完整内容看右侧预览栏（悬浮即切换）
.db-history-sql
  display -webkit-box
  -webkit-line-clamp 2
  -webkit-box-orient vertical
  overflow hidden
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  word-break break-all

.db-history-meta
  display flex
  gap 8px
  align-items center
  margin-top 2px
  color var(--text-dark)
  font-size 11px
  // 勾选框式的操作区占位后，时间/来源可能被压到折行（"失/败"竖排两个字）；
  // 只让来源那一项收缩省略，其余保持单行
  white-space nowrap
  min-width 0

.db-history-time
.db-history-fail
  flex 0 0 auto

.db-history-src
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// 条目右下角的操作组（复制 / 删除）：常驻占位、只切透明度——
// 显隐若用 display 切换，元信息行会跟着抖动，悬浮时正文跟着跳
.db-history-ops
  display flex
  align-items center
  gap 2px
  margin-left auto
  opacity 0
  .db-history-item:hover &
    opacity 1
  .db-history-item.is-active &
    opacity 1

.db-history-copy
  // 去掉 antd 文本按钮的横向内边距：两个 20px 的图标挤在一起才不撑宽元信息行
  padding 0 2px
  height 18px

// 删除：鼠标悬浮才露出的 X。
// 危险色交给 antd 的 danger 语义（hover 自带红字 + 淡红底），不在这一层写 :hover color——
// antd 的 text-button hover 规则是 `:where(...).ant-btn:not(:disabled):not(.ant-btn-disabled):hover`
// （0,4,0），类选择器压不住，写了也不生效（test.259 实测 hover 后变成近黑色，深色主题下看不见）
.db-history-del
  padding 0 2px
  height 18px

.db-history-fail
  color var(--error)

.db-history-empty
  padding 16px 8px
  text-align center
  color var(--text-dark)
  flex 1 1 auto

.db-history-note
  // 右侧让出 14px：右下角的拖拽把手压在弹层角上，注释文字别钻到它底下
  padding 6px 14px 0 4px
  border-top 1px solid var(--border)
  color var(--text-dark)
  font-size 11px

// 预览栏
.db-history-preview
  display flex
  flex-direction column
  flex 1 1 0
  min-width 0
  min-height 0
  padding-left 8px
  border-left 1px solid var(--border)

.db-history-pop[data-split='col'] .db-history-preview
  // 上下布局时预览固定占 40%，列表仍有 60% 可滚
  flex 0 0 40%
  padding-left 0
  padding-top 6px
  border-left none
  border-top 1px solid var(--border)

.db-history-preview-head
  display flex
  align-items center
  justify-content space-between
  padding-bottom 4px
  color var(--text-dark)
  font-size 11px

.db-history-preview-code
  flex 1 1 0
  min-height 0
  margin 0
  overflow auto
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  // pre-wrap 保换行与缩进（预览就是"原样长什么样"），长单词强制断行防横向滚动
  white-space pre-wrap
  word-break break-word
  tab-size 2

// 拖拽把手：右边缘改宽、右下角改宽高
.db-history-rz
  position absolute
  z-index 2
  -webkit-app-region no-drag

.db-history-rz-r
  top 0
  right 0
  width 6px
  bottom 16px
  cursor ew-resize

.db-history-rz-c
  right 0
  bottom 0
  width 14px
  height 14px
  cursor nwse-resize
  // 三道斜线做视觉提示（纯 CSS，不占 DOM）
  background linear-gradient(
    135deg,
    transparent 0 46%,
    var(--text-dark) 46% 52%,
    transparent 52% 62%,
    var(--text-dark) 62% 68%,
    transparent 68%
  )
  opacity 0.45
  &:hover
    opacity 0.9

// 拖拽期间禁选中：否则弹层里的语句文本会被刷成蓝色选中态
body.db-hist-resizing
  user-select none

// A-8：编辑器选项弹层
.db-sql-opts-pop
  width 220px

.db-sql-opts-head
  padding 0 4px 6px
  margin-bottom 4px
  border-bottom 1px solid var(--border)
  font-weight 500

.db-sql-opt-row
  display flex
  align-items center
  gap 8px
  padding 5px 4px
  border-radius var(--radius-sm)
  cursor pointer
  &:hover
    background var(--hover-bg)
  // popover 里 Switch 自带 4px 左右内距，行高统一靠这里压住
  .ant-switch
    flex 0 0 auto

.db-sql-opt-label
  flex 1 1 auto
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  font-size 12px

.db-sql-opts-note
  margin-top 6px
  padding 6px 4px 0
  border-top 1px solid var(--border)
  color var(--text-dark)
  font-size 11px

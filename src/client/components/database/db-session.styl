.db-session-wrap
  display flex
  flex-direction row
  height 100%
  width 100%
  overflow hidden
  padding 8px
  gap 8px

// 错误态：不沿用 .db-session-wrap 的 flex 行布局，避免 Alert 被拉伸满屏
.db-session-error
  display block
  padding 12px

.db-session-loading
  display flex
  align-items center
  gap 8px
  min-height 200px

.db-session-loading-text
  color var(--text)

// 左侧元数据树
.db-tree-panel
  flex none
  // 宽度由内联样式驱动（可拖拽调整，见 .db-tree-resizer），此处只约束范围
  min-width 160px
  max-width 600px
  height 100%
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  padding 4px

// 拖拽条：按住左右拖动可调整元数据树宽度
.db-tree-resizer
  flex none
  width 5px
  margin 0 2px
  cursor col-resize
  border-radius var(--radius-pill)
  background transparent
  transition background var(--dur-1) var(--ease)
  &:hover
    background var(--border)
  &:active
    background var(--primary)

.db-tree-head
  display flex
  align-items center
  justify-content space-between
  padding 2px 4px

.db-tree-title
  color var(--text)
  font-weight 500

// 右侧主区
.db-main-panel
  flex 1 1 0
  min-width 0
  height 100%
  display flex
  flex-direction column
  overflow hidden

.db-grid-area
  display flex
  flex-direction column
  height 100%
  overflow hidden

.db-grid-head
  display flex
  align-items center
  justify-content space-between
  padding 0 4px 8px

.db-grid-title
  color var(--text)
  font-weight 500

.db-grid-pager
  display flex
  align-items center
  gap 8px

.db-grid-page-no
  color var(--text)

.db-grid-table
  flex 1 1 0
  min-height 0
  overflow auto

.db-cell-null
  color var(--text)
  opacity 0.5

// 主区 Tabs：antd6 的内容层级为 body-holder > body > content，逐层撑满
.db-tabs
  height 100%
  display flex
  flex-direction column
  &.ant-tabs
    > .ant-tabs-nav
      margin 0 0 8px
    > .ant-tabs-body-holder
      flex 1 1 0
      min-height 0
      overflow hidden
      > .ant-tabs-body
        height 100%
        > .ant-tabs-content
          height 100%

// SQL 编辑器区
.db-sql-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-sql-editor
  flex none
  font-family var(--font-mono)

.db-sql-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-sql-result
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px

.db-sql-affected
  color var(--text)
  flex none

// Redis 键空间
.db-redis-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-redis-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-match
  flex 1 1 0
  min-width 120px
  max-width 360px

.db-redis-keys
  flex none
  max-height 45%
  overflow auto

.db-row-selected td
  background var(--active-bg)

.db-redis-detail
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px

.db-redis-detail-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-key-name
  max-width 40%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// 表结构区（列定义网格）
.db-struct-area
  flex 1 1 0
  min-height 0
  overflow auto

// 断线提示：贴在主区顶部，不挤占左右分栏
.db-conn-error
  flex none
  margin-bottom 8px

// 多结果集：每个结果集一块（含 affected 行 + 网格）
.db-sql-result-one
  display flex
  flex-direction column
  gap 4px

.db-sql-results-tabs
  height 100%

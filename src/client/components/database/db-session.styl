    display flex
    gap 4px
    padding 0 8px 6px

// B-2 收藏编辑弹窗：标题行 + 编辑器区
.db-fav-edit
  display flex
  flex-direction column
  gap 10px

.db-fav-edit-sql
  height 280px
  .db-sql-editor
    height 100%

// ---- D 批：EXPLAIN 弹窗（树/图/JSON 三视图） ----
.db-explain-toolbar
  display flex
  align-items center
  gap 8px
  margin-bottom 8px

.db-explain-body
  min-height 160px
  max-height 60vh
  overflow auto

.db-explain-svg
  display block

.db-explain-edge
  stroke var(--border)
  stroke-width 1.5

.db-explain-node
  fill var(--surface-1)
  stroke var(--main-light)

.db-explain-node-title
  fill var(--text)
  font-size 12px
  font-weight 600

.db-explain-node-sub
  fill var(--text-dark)
  font-size 11px

// 树视图：节点类型与 Extra 高亮（预估字段保持普通文本色）
.db-explain-type
  color var(--primary-text)
  font-weight 600

.db-explain-extra
  color var(--warn)

.db-explain-json-pre
  margin 0
  max-height 46vh
  overflow auto
  font-size 12px
  line-height 1.5
  color var(--text)
  font-family var(--db-code-font, var(--font-mono))

// ---- D 批：Redis 类型化写 ----
.db-redis-add-input
  width 110px

.db-redis-cell-edit
  display inline-flex
  align-items center
  gap 4px
  width 100%

// SQL 编辑器选区右键「解释所选」：透明遮罩 + 单项菜单
.db-sql-ctx-overlay
  position fixed
  z-index 1000
  inset 0

.db-sql-ctx-menu
  position fixed
  background var(--surface-1)
  border 1px solid var(--border)
  border-radius var(--radius-xs)
  box-shadow var(--shadow-2)
  padding 4px
  min-width 120px

.db-sql-ctx-item
  padding 5px 12px
  border-radius var(--radius-xs)
  color var(--text)
  cursor pointer
  font-size 12px
  &:hover
    background var(--hover-bg)

// B3-1 列聚合摘要（选中单元格后出现在网格工具条上）。
// 数字用等宽字体：Σ/⌀ 数值跳动时不会左右抖
.db-cell-summary
  margin-left 8px
  font-family var(--font-mono, monospace)
  font-size 11px
  color var(--text-dark)
  white-space nowrap

.db-cell-summary-null
  margin-left 6px
  color var(--text-light, var(--text-dark))

// ------------------------------------------------------------------ //
// H1a-2：列宽可控（5 处网格共用的表头手柄 + 单例列头菜单）
// ------------------------------------------------------------------ //
// 5 处网格**共用**的表头标题容器（数据页 / SQL 结果 / 表结构 / Redis 键列表 / Redis 详情）。
// 合同：手柄绝对定位在右边沿，所以容器必须 relative；列名要能各自截断所以 min-width 0；
// gap 只在真的多出一行（数据页的注释）时才有尺寸，单行表头不受影响 ——
// flex 的 gap 只作用于在流内的相邻项，箭头与手柄都是 absolute。
// 原来数据页另有一条同构的 .db-col-title（两份只差一个 gap），两页各用一套就是
// "表头格式不统一"的一半来源；合并成一条后，剩下的差异只有"有没有注释那一行"
.db-col-head
  position relative
  display flex
  flex-direction column
  gap 1px
  min-width 0
  line-height 1.35

// 列头菜单：全站单例（一份浮层服务 5 处网格），内容就是三行按钮。
// 用 button 而不是 div：Tab/Enter 天然可用，键盘用户不必靠鼠标
.db-col-menu
  display flex
  flex-direction column
  gap 2px
  min-width 168px

.db-col-menu-head
  padding 0 6px 4px
  margin-bottom 2px
  border-bottom 1px solid var(--border)
  color var(--text-dark)
  font-size 11px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-col-menu-item
  display block
  width 100%
  padding 4px 6px
  border 0
  border-radius var(--radius-sm)
  background transparent
  color var(--text)
  font-size 12px
  text-align left
  cursor pointer
  &:hover
    background var(--hover-bg)

// 菜单锚点：与预览卡同理 —— fixed 元素 offsetParent 恒为 null，0×0 会被
// rc-trigger 的 isVisible 判成"不可见"，浮层就永远停在 -1000vw/-1000vh。
// 1px 透明 + 不吃事件，视觉上等价于不存在。
.db-col-menu-anchor
  position fixed
  width 1px
  height 1px
  pointer-events none

// 单元格右键菜单的锚点：规则与列宽菜单完全一致，类名分开是为了让
// "列宽菜单单例"的回归判据（数 .db-col-menu-anchor）不被另一个组件污染
.db-cell-menu-anchor
  position fixed
  width 1px
  height 1px
  pointer-events none

// SQL 结果单元格右键菜单：与列宽菜单同一套外观（单例浮层、12px 项、token 上色）
.db-cell-menu
  display flex
  flex-direction column
  gap 2px
  min-width 168px

.db-cell-menu-head
  padding 0 6px 4px
  margin-bottom 2px
  border-bottom 1px solid var(--border)
  color var(--text-dark)
  font-size 11px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-cell-menu-item
  display block
  width 100%
  padding 4px 6px
  border 0
  border-radius var(--radius-sm)
  background transparent
  color var(--text)
  font-size 12px
  text-align left
  cursor pointer
  &:hover
    background var(--hover-bg)

// H1 行详情：字段名定宽 + 值自适应，逐字段可展开/复制
.db-row-detail-scroll
  max-height 60vh
  overflow auto

.db-row-detail
  display flex
  flex-direction column

.db-row-detail-item
  display flex
  align-items flex-start
  gap 8px
  padding 6px 0
  border-bottom 1px solid var(--border)
  &:last-child
    border-bottom 0

.db-row-detail-name
  flex 0 0 180px
  display flex
  flex-direction column
  gap 2px
  overflow hidden

.db-row-detail-field
  color var(--text-dark)
  font-size 12px
  font-family var(--db-code-font, var(--font-mono))
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// 字段名与 NULL 值：弱化用 --text-muted，不用 opacity（浅色主题下 0.6 只剩 2.7:1）
.db-row-detail-type
  color var(--text-muted)
  font-size 11px

.db-row-detail-value
  flex 1 1 auto
  min-width 0
  margin 0
  padding 2px 6px
  border-radius var(--radius-sm)
  background var(--hover-bg)
  color var(--text)
  font-size 12px
  font-family var(--db-code-font, var(--font-mono))
  white-space pre-wrap
  word-break break-all
  &.is-null
    color var(--text-muted)
    font-style italic

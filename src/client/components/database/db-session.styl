.db-session-wrap
  display flex
  flex-direction row
  height 100%
  width 100%
  overflow hidden
  padding 8px
  gap 8px

// 错误态：不沿用 .db-session-wrap 的 flex 行布局，避免 Alert 被拉伸满屏
.db-session-error
  display block
  padding 12px

.db-session-loading
  display flex
  align-items center
  gap 8px
  min-height 200px

.db-session-loading-text
  color var(--text)

// 左侧元数据树
.db-tree-panel
  flex none
  // 宽度由内联样式驱动（可拖拽调整，见 .db-tree-resizer），此处只约束范围
  min-width 160px
  max-width 600px
  height 100%
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  padding 4px

// 拖拽条：命中区骑跨在左侧容器右边框上，因此"拖的就是容器边缘"，
// 而不是浮在面板与主区之间的独立竖条。
// 定位算术：margin-left = -(gap 8 + 半宽 4) = -12 → 左边缘落在边框左 4px；
// margin-right = +12 补回，净占位仍是 9px，故右侧主区位置与改动前完全一致。
.db-tree-resizer
  flex none
  position relative
  z-index 5
  width 9px
  margin 0 12px 0 -12px
  cursor col-resize
  background transparent
  &::after
    content ''
    position absolute
    top 0
    bottom 0
    left 4px
    width 1px
    background transparent
    transition background var(--dur-1) var(--ease)
  &:hover::after
    background var(--primary)
  &:active::after
    background var(--primary)

// Redis 数据库节点：名称居左、键个数居右
.db-tree-db
  display flex
  align-items center
  justify-content space-between
  gap 8px
  width 100%

.db-tree-db-count
  color var(--text-dark)
  font-size 12px
  font-variant-numeric tabular-nums

.db-tree-head
  display flex
  align-items center
  justify-content space-between
  padding 2px 4px

.db-tree-title
  color var(--text)
  font-weight 500

// 右侧主区
.db-main-panel
  flex 1 1 0
  min-width 0
  height 100%
  display flex
  flex-direction column
  overflow hidden

.db-grid-area
  display flex
  flex-direction column
  height 100%
  overflow hidden

.db-grid-head
  display flex
  align-items center
  justify-content space-between
  padding 0 4px 8px

.db-grid-title
  color var(--text)
  font-weight 500

.db-grid-pager
  display flex
  align-items center
  gap 8px

.db-grid-page-no
  color var(--text)

// 近似总行数（次要信息）
.db-grid-total
  color var(--text-dark)
  font-size 12px

// 取数失败：错误落在表格区内（不再只 toast）
.db-grid-error
  flex none
  margin-bottom 8px

// 空表提示
.db-empty-tip
  color var(--text-dark)

.db-grid-table
  flex 1 1 0
  min-height 0
  overflow auto

.db-cell-null
  color var(--text)
  opacity 0.5

// 可编辑单元格（非只读且有主键）：hover 细线提示"可双击编辑"
.db-cell-editable:hover
  box-shadow inset 0 -1px 0 0 var(--primary)

.db-cell-editor
  width 100%

// 主区 Tabs：antd6 的内容层级为 body-holder > body > content，逐层撑满
.db-tabs
  height 100%
  display flex
  flex-direction column
  &.ant-tabs
    > .ant-tabs-nav
      margin 0 0 8px
    > .ant-tabs-body-holder
      flex 1 1 0
      min-height 0
      overflow hidden
      > .ant-tabs-body
        height 100%
        > .ant-tabs-content
          height 100%

// SQL 编辑器区
.db-sql-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-sql-editor
  flex none
  font-family var(--font-mono)

.db-sql-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-sql-result
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px

.db-sql-affected
  color var(--text)
  flex none

// Redis 键空间
.db-redis-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-redis-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-match
  flex 1 1 0
  min-width 120px
  max-width 360px

.db-redis-keys
  flex none
  max-height 45%
  overflow auto

.db-row-selected td
  background var(--active-bg)

.db-redis-detail
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px

.db-redis-detail-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-key-name
  max-width 40%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// 表结构区（列定义网格）
.db-struct-area
  flex 1 1 0
  min-height 0
  overflow auto

// 断线提示：贴在主区顶部，不挤占左右分栏
.db-conn-error
  flex none
  margin-bottom 8px

// 多结果集：每个结果集一块（含 affected 行 + 网格）
.db-sql-result-one
  display flex
  flex-direction column
  gap 4px

.db-sql-results-tabs
  height 100%

.db-session-wrap
  display flex
  flex-direction column
  height 100%
  width 100%
  overflow hidden
  // S6：数据面禁连字，防 0/O、l/1、=>/≠ 等视觉混淆（对非数据面文本无副作用）
  font-variant-ligatures none

// 顶部工具条：引擎/目标/状态 + 只读/刷新。
// 高度口径 = tokens.styl --session-bar-h（与 .terminal-control 统一；
// session/sessions.jsx 的扣减依赖该值，JS 侧镜像见 constants.js termControlHeight）
.db-head
  flex none
  height var(--session-bar-h)
  display flex
  align-items center
  gap 8px
  padding 0 10px
  border-bottom 1px solid var(--border)
  font-size 12px

.db-head-engine
  flex none
  padding 0 6px
  border-radius var(--radius-sm)
  background var(--hover-bg)
  line-height 18px

.db-head-target
  min-width 0
  color var(--text-dark)

.db-head-state
  flex none
  display flex
  align-items center
  gap 4px
  color var(--text-dark)

.db-head-dot
  width 6px
  height 6px
  border-radius var(--radius-pill)
  background var(--success)
  &.err
    background var(--error)

// 风险/系统库/连接动作紧跟在连接信息之后（左起排列），不推到工具条最右端
.db-head-right
  display flex
  align-items center
  gap 6px

// U1：右侧按语义分组。组内 6px，组与组之间只留一条 1px 竖线，
// 让"生产标记 + 只读"读成一个整体，而不是和刷新按钮混成一排控件
.db-tool-group
  display inline-flex
  align-items center
  gap 6px

.db-tool-sep
  flex none
  width 1px
  height 14px
  background var(--border)

// 窗口级动作（查找/全屏）：靠右，与终端顶栏 SessionControl 右侧控件同位置同口径
// （S1 起图标本体来自 common/session-bar-actions.jsx，激活态类 .search-open 全局共用）
.db-head-actions
  margin-left auto
  display flex
  align-items center
  gap 6px
  color var(--text-dark)

// 查找命中标记：非当前 = 弱化品牌色；当前 = 主色 + 外描边（颜色走 token：CSS 契约禁止裸色值）
.db-kw-hit
  background var(--accent-wash)
  color var(--text)
  &.db-kw-cur
    background var(--primary)
    color var(--primary-contrast)
    outline 1px solid var(--primary-contrast)
  border-radius var(--radius-xs)

// T1/T2 局部过滤命中：独立 class，避免被顶栏查找的计数与导航误收
.db-page-hit
  background var(--accent-wash)
  color var(--text)
  border-radius var(--radius-xs)
.db-tree-hit
  background var(--accent-wash)
  color var(--text)
  border-radius var(--radius-xs)

// 左右分栏容器（树 | 拖拽条 | 主区）：原 .db-session-wrap 的内边距搬到这里
.db-body
  flex 1 1 0
  min-height 0
  display flex
  flex-direction row
  padding 8px
  gap 8px
  overflow hidden

// 错误态：不沿用 .db-session-wrap 的 flex 行布局，避免 Alert 被拉伸满屏
.db-session-error
  display block
  padding 12px

.db-session-loading
  display flex
  align-items center
  gap 8px
  min-height 200px

.db-session-loading-text
  color var(--text)

// 左侧元数据树
.db-tree-panel
  flex none
  // 宽度由内联样式驱动（可拖拽调整，见 .db-tree-resizer），此处只约束范围
  min-width 160px
  max-width 600px
  height 100%
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  padding 4px
  // 容器是圆角、全局滚动条 thumb 是直角，滚动到两端时与圆角相切/被裁；
  // 这里让 thumb 也圆角，并用 1px 透明边框 + content-box 裁切使其内缩，避免贴角
  &::-webkit-scrollbar-thumb
    border-radius var(--radius-xs)
    border 1px solid transparent
    background-clip content-box

// T2 树过滤：占树面板顶部一行，不改变面板高度
.db-tree-filter
  margin-bottom 6px

.db-tree-filter-count
  color var(--text-dark)
  font-size 12px
  margin 0 2px 6px
  white-space nowrap
  font-variant-numeric tabular-nums

// 拖拽条：命中区骑跨在左侧容器右边框上，因此"拖的就是容器边缘"，
// 而不是浮在面板与主区之间的独立竖条。
// 定位算术：margin-left = -(gap 8 + 半宽 4) = -12 → 左边缘落在边框左 4px；
// margin-right = +12 补回，净占位仍是 9px，故右侧主区位置与改动前完全一致。
.db-tree-resizer
  flex none
  position relative
  z-index 5
  width 9px
  margin 0 12px 0 -12px
  cursor col-resize
  background transparent
  &::after
    content ''
    position absolute
    top 0
    bottom 0
    left 4px
    width 1px
    background transparent
    transition background var(--dur-1) var(--ease)
  &:hover::after
    background var(--primary)
  &:active::after
    background var(--primary)

// Redis 数据库节点：名称居左、键个数居右
.db-tree-db
  display flex
  align-items center
  justify-content space-between
  gap 8px
  width 100%

.db-tree-db-count
  color var(--text-dark)
  font-size 12px
  font-variant-numeric tabular-nums

// mysql 元数据 per-db 降级标记（单库 SHOW TABLES 失败，悬停见错误详情）
.db-tree-db-err
  color var(--error)
  margin-left 5px
  font-weight bold

// 工具条里"标签 + Switch"的开关（只读 / 系统库）：两个开关并排，
// 标签让它们不靠 tooltip 也能分清
.db-sys-toggle
  display inline-flex
  align-items center
  gap 4px
.db-tool-label
  color var(--text-dark)
  font-size 12px
  white-space nowrap

// 右侧主区
.db-main-panel
  flex 1 1 0
  min-width 0
  height 100%
  display flex
  flex-direction column
  overflow hidden

.db-grid-area
  display flex
  flex-direction column
  height 100%
  overflow hidden

// 表名 + 行数估算 + 动作 + 翻页：一条左对齐的控制条（与 Redis 的 .db-redis-bar 同款），
// 不用 space-between 把控件摊到整行两端。
// U1：允许折行 —— 这一行有十几个控件，900px 宽时横向溢出（实测 scrollWidth 1143 >
// clientWidth 569，右侧按钮被裁掉且表名被压成 0 宽）；折行后翻页整组落到第二行
.db-grid-head
  display flex
  align-items center
  flex-wrap wrap
  gap 8px
  row-gap 6px
  padding 0 4px 8px
  min-width 0

// 翻页 + 页大小：整组不拆行。宽屏贴右端，窄屏整组折到第二行
.db-grid-head-pager
  display inline-flex
  align-items center
  gap 6px
  margin-left auto

// U1c：无表选中时的数据页工作台首页（连接摘要 + 快捷入口 + 最近表）
.db-home
  display flex
  align-items center
  justify-content center
  height 100%
  padding 16px
  overflow auto

.db-home-card
  width 100%
  max-width 620px
  padding 16px
  border 1px solid var(--border)
  border-radius var(--radius-lg)
  background var(--surface-1)

.db-home-summary
  display flex
  align-items center
  flex-wrap wrap
  gap 8px
  font-size 12px
  color var(--text-dark)

.db-home-engine
  padding 0 6px
  border-radius var(--radius-sm)
  background var(--hover-bg)
  color var(--text)
  line-height 18px

.db-home-target
  min-width 0
  max-width 60%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-home-flag
  padding 0 6px
  border 1px solid var(--border)
  border-radius var(--radius-pill)
  color var(--text-dark)
  font-size 11px
  line-height 16px

  &.is-prod
    border-color var(--error)
    background var(--error-bg)
    color var(--error)

.db-home-title
  margin-top 12px
  color var(--text)
  font-size 15px
  font-weight 500

.db-home-hint
  margin-top 4px
  color var(--text-dark)
  font-size 12px

.db-home-actions
  display flex
  align-items center
  flex-wrap wrap
  gap 8px
  margin-top 14px

.db-home-caret
  margin-left 4px
  font-size 10px

.db-home-recent
  margin-top 16px
  padding-top 12px
  border-top 1px solid var(--border)

.db-home-recent-head
  display flex
  align-items baseline
  gap 6px
  font-size 12px
  color var(--text-dark)

.db-home-recent-title
  color var(--text)
  font-weight 500

.db-home-tables
  display flex
  flex-wrap wrap
  gap 6px
  margin-top 8px

// 表名用原生 button：可 Tab 到、回车即开，样式与 antd 小按钮同口径
.db-home-table
  display inline-flex
  align-items center
  gap 5px
  height 24px
  padding 0 8px
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  background transparent
  color var(--text)
  font-family inherit
  font-size 12px
  cursor pointer
  transition border-color var(--dur-1) var(--ease), background var(--dur-1) var(--ease)

  &:hover
    border-color var(--primary)
    background var(--hover-bg)

  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset 1px

.db-home-table-name
  max-width 220px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-home-empty
  margin-top 8px
  color var(--text-dark)
  font-size 12px

.db-grid-title
  color var(--text)
  font-weight 500
  // 表名过长时截断，不挤走后面的控件
  max-width 45%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-grid-pager
  display flex
  align-items center
  gap 8px

.db-grid-page-no
  color var(--text)

// 页码快速跳转标签（当前页 ±1 + 首/末页 + 省略号）
.db-grid-page-tags
  display flex
  align-items center
  gap 4px

// 跳页输入
.db-grid-jump
  width 72px

// 近似总行数（次要信息）
.db-grid-total
  color var(--text-dark)
  font-size 12px
  display inline-flex
  align-items center
  gap 4px
  // 行数/耗时是数字，等宽避免翻页时数字宽度变化把后面的控件推来推去
  font-variant-numeric tabular-nums

// U1d：本页行数是这一屏的确定值，比"总行数（约）"更该被读到，所以给它主文本色；
// 估算/精确总数保持次要色，中间那个点负责分隔两种口径
.db-grid-page-rows
  color var(--text)

.db-grid-dot
  opacity 0.6

// 选中计数：勾选后出现在批量动作组首。用主色是因为它代表"接下来会改到这些行"。
// 文字用主色一律走 --primary-text：--primary(#08c) 直接当正文色，浅色主题卡片底上只有 3.3:1
.db-grid-selected
  color var(--primary-text)
  font-size 12px

// T11 精确总行数：文字按钮与 exact 标记
.db-exact-btn
  padding 0
  height auto
  font-size 12px
.db-exact-tag
  margin 0
  padding 0 3px
  font-size 10px
  line-height 14px
  border-radius var(--radius-xs)

// B1 插入行弹窗：列名(含 PK/自增标记) + 输入框 + NULL 勾选，一行一列
.db-insert-form
  display flex
  flex-direction column
  gap 8px
  max-height 60vh
  overflow-y auto
  padding-right 4px
.db-insert-row
  display flex
  align-items center
  gap 8px
.db-insert-col
  flex 0 0 38%
  display inline-flex
  align-items center
  gap 4px
  min-width 0
.db-insert-col-name
  color var(--text)
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
.db-insert-col-type
  flex 0 0 auto
  color var(--text-dark)
  font-size 11px
.db-insert-row .ant-input
  flex 1 1 auto
  min-width 0

// B3-2 批量改值弹窗
.db-bulk-form
  display flex
  flex-direction column
  gap 10px
  padding-top 6px
.db-bulk-row
  display flex
  align-items center
  gap 8px
.db-bulk-label
  flex 0 0 56px
  color var(--text)
.db-bulk-hint
  color var(--text-dark)
  font-size 12px

// B3-3 查找替换弹窗
.db-replace-form
  display flex
  flex-direction column
  gap 10px
  padding-top 6px
.db-replace-row
  display flex
  align-items center
  gap 8px
.db-replace-label
  flex 0 0 56px
  color var(--text)
.db-replace-opts
  display flex
  gap 18px
.db-replace-preview
  color var(--text-dark)
  font-size 12px
  // 非文本列的提示不是"没匹配到"，要用警示色区分，否则用户会以为是查找写错了
  &.is-warn
    color var(--warn)

// A2 结构 tab 工具行 + DDL 弹窗等宽展示
.db-struct-tools
  display flex
  gap 8px
  margin-bottom 8px

// H3b-3：ER 图弹层。高度按视口给（85vh），画布是唯一的弹性区 ——
// 弹层默认高度随内容走，图会被上下几条提示挤成一条
.db-er-modal
  .ant-modal-container
    height 85vh
    display flex
    flex-direction column
  .ant-modal-body
    flex 1 1 auto
    min-height 0
    display flex
    flex-direction column
.db-er
  flex 1 1 auto
  min-height 0
  display flex
  flex-direction column
  gap 8px
.db-er-err
  flex none
.db-er-note
  flex none
  padding 4px 8px
  border-radius var(--radius-xs)
  background var(--warn-bg)
  color var(--warn)
  font-size 12px
.db-er-head
  flex none
  display flex
  align-items center
  justify-content space-between
  gap 12px
  font-size 12px
  color var(--text-muted)
.db-er-zoom
  font-family var(--db-code-font, var(--font-mono))
.db-er-canvas
  position relative
  flex 1 1 auto
  min-height 0
  overflow hidden
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  background var(--surface-1)
  cursor grab
  user-select none
  &.is-dragging
    cursor grabbing
// 转圈/空态盖在画布上：图还没到时也保持弹层高度稳定，不闪一下再撑开
.db-er-center
  position absolute
  inset 0
  display flex
  align-items center
  justify-content center
  color var(--text-muted)
  font-size 12px
  pointer-events none
.db-er-svg
  display block
  width 100%
  height 100%
.db-er-arrow-head
  fill var(--text-muted)
.db-er-arrow-hot
  fill var(--primary)
.db-er-edge
  path
    fill none
    stroke var(--border-strong)
    stroke-width 1.5
  &.is-hot
    path
      stroke var(--primary)
      stroke-width 2
  &.is-dim
    opacity .25
// 节点底色必须和画布（--surface-1）分开：同色时只剩描边，一排表看起来像空框
.db-er-node
  cursor grab
  rect
    fill var(--surface-2)
    stroke var(--border-strong)
    stroke-width 1
    transition fill var(--dur-1) var(--ease), stroke var(--dur-1) var(--ease)
  &:hover rect
    stroke var(--primary)
  &.is-selected rect
    fill var(--accent-wash)
    stroke var(--primary)
    stroke-width 2
  &.is-dim
    opacity .3
.db-er-node-name
  font-size 12px
  fill var(--text)
  font-family var(--db-code-font, var(--font-mono))
.db-er-node-sub
  font-size 10px
  fill var(--text-muted)
  font-family var(--db-code-font, var(--font-mono))
.db-er-detail
  flex none
  display flex
  align-items center
  flex-wrap wrap
  gap 8px
  padding 6px 8px
  border-radius var(--radius-xs)
  background var(--hover-bg)
  font-size 12px
  .ant-btn
    margin-left auto
.db-er-detail-title
  font-family var(--db-code-font, var(--font-mono))
  font-weight 600
  color var(--text)
.db-er-detail-sub
  color var(--text-muted)
.db-er-detail-list
  display flex
  flex-wrap wrap
  gap 4px 14px
  margin 0
  padding 0
  list-style none
  color var(--text)
  li
    display flex
    align-items center
    gap 6px
.db-er-detail-fk
  color var(--text-muted)
.db-er-detail-col
  font-family var(--db-code-font, var(--font-mono))
.db-er-detail-sep
  color var(--text-muted)
// H4：结构对比弹层。选择器与概览固定，只有差异列表滚动 ——
// 几百列的表不能把弹层撑到视口外
.db-diff
  display flex
  flex-direction column
  gap 10px
.db-diff-pick
  display flex
  align-items center
  flex-wrap wrap
  gap 8px
.db-diff-pick-label
  font-size 12px
  color var(--text-muted)
.db-diff-select
  width 260px
.db-diff-swap
  color var(--text-muted)
.db-diff-err
  margin 0
.db-diff-hint
  min-height 24px
  color var(--text-muted)
  font-size 12px
.db-diff-summary
  display flex
  flex-wrap wrap
  gap 6px
.db-diff-count
  margin 0
  border none
  font-size 12px
  &.is-removed
    color var(--error)
    background var(--error-bg)
  &.is-added
    color var(--success)
    background var(--success-bg)
  &.is-changed
    color var(--warn)
    background var(--warn-bg)
  &.is-equal
    color var(--text-muted)
    background var(--hover-bg)
.db-diff-body
  max-height 56vh
  overflow auto
  padding-right 4px
.db-diff-section
  & + &
    margin-top 12px
.db-diff-section-title
  margin-bottom 6px
  font-size 12px
  font-weight 600
  color var(--text-dark)
.db-diff-row
  display flex
  align-items flex-start
  gap 8px
  padding 4px 6px
  border-radius var(--radius-xs)
  font-size 12px
  & + &
    margin-top 2px
  &:hover
    background var(--hover-bg)
.db-diff-tag
  flex none
  margin 0
  border none
  font-size 11px
  line-height 18px
.db-diff-row.is-removed .db-diff-tag
  color var(--error)
  background var(--error-bg)
.db-diff-row.is-added .db-diff-tag
  color var(--success)
  background var(--success-bg)
.db-diff-row.is-changed .db-diff-tag
  color var(--warn)
  background var(--warn-bg)
.db-diff-name
  flex none
  min-width 120px
  font-family var(--db-code-font, var(--font-mono))
  color var(--text)
.db-diff-values
  display flex
  flex-wrap wrap
  gap 4px 12px
  min-width 0
.db-diff-field
  display inline-flex
  align-items baseline
  gap 4px
.db-diff-field-key
  color var(--text-muted)
.db-diff-old
  font-family var(--db-code-font, var(--font-mono))
  color var(--error)
.db-diff-arrow
  color var(--text-muted)
.db-diff-new
  font-family var(--db-code-font, var(--font-mono))
  color var(--success)
.db-diff-brief
  color var(--text-muted)
  font-family var(--db-code-font, var(--font-mono))
  word-break break-all
.db-ddl-pre
  margin 0
  max-height 60vh
  overflow auto
  padding 10px
  border-radius var(--radius-sm)
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  white-space pre
  color var(--text)

// T4 PG 跨库连接入口与确认弹窗
.db-tree-connect
  margin-left 6px
  padding 0
  height auto
  font-size 12px
.db-connect-rows
  display flex
  flex-direction column
  gap 6px
  margin-bottom 12px
.db-connect-row
  display flex
  gap 8px
.db-connect-row > span:first-child
  width 72px
  color var(--text-dark)

// PG 树 schema 节点：S 标记与名称同排
.db-tree-schema
  display inline-flex
  align-items center
  gap 4px
.db-tree-schema-mark
  padding 0 3px
  border 1px solid var(--border)
  border-radius var(--radius-xs)
  color var(--text-dark)
  font-size 10px
  line-height 14px

// B2：库内对象分组（过程与函数 / 触发器 / 事件）的 G 标记。
// 与 schema 的 S 标记同一套视觉语言；行高必须与其它树节点严格一致，
// 故沿用 inline-block + 10px 字号，不加 vertical-align
.db-tree-group-mark
  padding 0 3px
  border 1px solid var(--border)
  border-radius var(--radius-xs)
  color var(--text-dark)
  font-size 10px
  line-height 14px

// F0：视图叶子节点的 V 标记（与 .db-tree-schema-mark 同一套视觉语言：
// 小方块 + 单字母）。视图在树里与表同名同形，没有标记就分不出来
// 关键：不能用 inline-flex 包文字。实测 inline-flex 会把树行从 24px 撑到 25px
// （baseline 对齐留 descent），加 vertical-align:middle 更是到 26px——
// 整棵树的行高必须严格一致，否则滚动时行会一高一低地抖
.db-tree-view
  display inline

.db-tree-view-mark
  display inline-block
  margin-right 4px
  padding 0 3px
  border 1px solid var(--border)
  border-radius var(--radius-xs)
  color var(--text-dark)
  font-size 10px
  line-height 14px
  vertical-align text-bottom

// PG 表结构主键徽标（列定义网格）
.db-pk-tag
  margin 0
  padding 0 4px
  font-size 11px
  line-height 16px
  border-radius var(--radius-xs)

// T1 当前页过滤：窄窗口允许收缩，不把网格头挤成两行
.db-page-filter
  width 132px
  flex 0 1 132px
  min-width 96px

.db-page-filter-count
  color var(--text-dark)
  font-size 12px
  white-space nowrap
  font-variant-numeric tabular-nums

// 取数失败：错误落在表格区内（不再只 toast）
.db-grid-error
  flex none
  margin-bottom 8px

// 空表提示
.db-empty-tip
  color var(--text-dark)

// 主数据网格滚动容器（仅数据 tab 的表格用）：
// 滚动权交给 antd 内部表体（scroll.y 定高），横向滚动条常驻可视区底边、表头吸顶
// （见 doc/已完成/数据库功能设计归档-2026-10-21.md）；其余 Table（SQL 结果/表结构/Redis）仍走 .db-grid-table 旧滚动
.db-grid-table-wrap
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.db-grid-table
  // basis 用 auto 而非 0：wrap 定高（主网格等）时效果相同，
  // 但在 auto 高度的 wrap 里（如 .db-redis-keys 的 max-height 45%）不会把内容高缩成 0
  flex 1 1 auto
  min-height 0
  overflow auto
  // S6：网格单元格数据面字体与终端统一
  font-family var(--db-code-font, var(--font-mono))

// B1 行选择列：scroll.y 生效后表头/表体是两个独立 table，列宽由 colgroup 决定，
// 而 colgroup 的宽度来自 antd rowSelection.columnWidth（见 db-session.jsx SEL_COL_W）。
// 这里只管盒模型：同宽 + 内边距，保证 16px 勾选框左右各留 10px 不被贴边裁切。
// ⚠️ 只靠 CSS 给宽度不够：列宽总和超容器时，表头那套 table 会把该列压成 1px
.db-grid-table .ant-table-selection-column
  width 36px
  min-width 36px
  padding-left 10px
  padding-right 10px

// U2：行悬停/选中态统一吃 token。antd 那两层底色来自它内部 colorPrimary 的派生
// （实测 hover = rgb(27,46,63)、选中 = rgb(14,55,75)），换主题时不会跟着
// --hover-bg / --active-bg 走 —— 网格的交互态和界面其余部分就成了两套配色。
// 选择器写 .ant-table-cell 而不是 td：DbGridTable 在 scroll.y > 0 时开虚拟表体，
// 那时行与格都是 div，`td` 那条选择器直接落空（Redis 键列表的选中态就这么丢过）。
// tbody → row 那层用后代而非子选择器：虚拟表体在两者之间还插了
// .ant-table-tbody-virtual-holder(-inner) 两层 div，`>` 同样会落空。
// 对 antd 的规则要"类数严格多于它"才稳：它选中态那条写了 5 个类
// （wrapper/tbody/row/row-selected/cell），打平只能靠样式表先后，而 antd 的
// CSS-in-JS 是运行时注入的，先后不保证 —— 所以这里把链路写全
// （.db-grid-table .ant-table .ant-table-tbody），选中态再补 row + selected 两个类。
.db-grid-table
  // 格内正文用不透明 --text：antd 给单元格的是它自己的 colorText（实测 rgba(85,85,85,.88)），
  // 半透明文字压在 16% 主色浸染底上只剩 4.2:1，浅色主题不达标（U2c 实测）
  .ant-table .ant-table-tbody .ant-table-row > .ant-table-cell
    color var(--text)
    transition background var(--dur-1) var(--ease)
  .ant-table .ant-table-tbody .ant-table-row:hover > .ant-table-cell
    background var(--hover-bg)
  // 悬停不改变选中行：选中 + 悬停仍是 --active-bg，否则勾中的行在鼠标划过时闪一下
  .ant-table .ant-table-tbody .ant-table-row.ant-table-row-selected > .ant-table-cell,
  .ant-table .ant-table-tbody .ant-table-row.ant-table-row-selected:hover > .ant-table-cell
    background var(--active-bg)

// NULL / 空串占位：弱化一律用 --text-muted，不再用 opacity
// （实测 opacity 0.5 在浅色主题只剩 2.2:1、0.45 只剩 2.0:1，深色主题压进选中底也只有 4.0:1；
//  对比度判据见 self-test/db-contrast-demo.js）
.db-cell-null
  color var(--text-muted)

// H2 空串占位：和 NULL 一样都是"没内容"，但语义不同（'' 是值，NULL 不是）。
// 区分靠字形（"" 一对引号）与细体，不靠更低的对比度
.db-cell-empty
  color var(--text-muted)
  font-weight 300

// 关键字高亮（.db-kw）颜色由终端主题决定，在 db-highlight.jsx 里以内联 style 上色，
// 这里不再写死色值（CSS 契约：非 includes 目录禁止硬编码颜色）

// 可编辑单元格（非只读且有主键）：hover 细线提示"可双击编辑"
// 作用在 td 上（onCell），因此整格留白也是双击命中区
// 用 outline 而非 box-shadow：CSS 契约禁止 box-shadow 里的 px 字面量
.db-cell-editable
  cursor text
  &:hover
    outline 1px solid var(--primary)
    outline-offset -1px
  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset -2px

.db-cell-editor
  width 100%

// H1a-3：数值列右对齐。class 打在 td 上（onCell），判定在列定义里做一次
// （db-format-value.js 的 cellAlignClass）—— 表头刻意不动：列头右边沿是列宽
// 拖拽手柄的热区（H1a-2 几何契约 right:0 + z-index:2），右对齐会把列名压进
// col-resize 光标底下，看着像坏了。
// tabular-nums：右对齐靠的是数位对齐，比例字体下 1 比 8 窄，对齐了也看不出对齐
.db-cell-num
  text-align right
  font-variant-numeric tabular-nums

// H1a-4：SQL 结果里"完整值面板正在看这一格"的落点标记。没有它，点完只能靠工具条
// 上的列名回忆自己点了哪儿。描边而不是换底色：底色会和行悬停色打架
.db-cell-selected
  box-shadow inset 0 0 0 1px var(--primary)
  background var(--active-bg)

// 值预览（原文 / 格式化都走这里）：等宽、可滚动、可选中复制，内容已按关键字高亮
.db-value-pre
  flex 1 1 auto
  min-height 0
  margin 0
  padding 6px 8px
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  background var(--main)
  color var(--text)
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  line-height 1.5
  white-space pre-wrap
  word-break break-all
  user-select text

// 主区 Tabs：antd6 的内容层级为 body-holder > body > content，逐层撑满
// （.db-sql-results-tabs 是 SQL 多结果集分栏，同一撑满链路）
.db-tabs, .db-sql-results-tabs
  height 100%
  display flex
  flex-direction column
  &.ant-tabs
    > .ant-tabs-nav
      margin 0 0 8px
    > .ant-tabs-body-holder
      flex 1 1 0
      min-height 0
      overflow hidden
      > .ant-tabs-body
        height 100%
        > .ant-tabs-content
          height 100%

// SQL 编辑器区
.db-sql-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

// 历史/收藏按钮内的收藏数小圆片：内联随文字排布（替代骑角 Badge——
// 按钮上方仅 1px 空隙，骑角位上移顶编辑器、不移压"藏"字，无法两全）
.db-hist-fav-count
  display inline-block
  margin-left 6px
  padding 0 5px
  border-radius var(--radius-pill)
  background var(--error)
  color var(--text-on-status)
  font-size 10px
  line-height 14px
  font-weight 500
  vertical-align middle

// A-1：CM6 外壳容器。边框/圆角/尺寸由编辑器主题（db-sql-editor.jsx）给出，
// 这里只管它在 flex 列里的行为，以及懒加载骨架屏的占位尺寸。
.db-sql-editor
  flex none
  font-family var(--db-code-font, var(--font-mono))
  overflow hidden

// 骨架屏：与编辑器同尺寸同边框，chunk 到位后替换不产生跳动
.db-sql-editor-skeleton
  min-height 96px
  max-height 260px
  border 1px solid var(--main-light)
  border-radius var(--radius-xs)

.db-sql-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-sql-result
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px
  // 结果外层的 antd Spin 包装层必须参与 flex 传高，
  // 否则内部 .db-grid-table-wrap 拿不到确定高度（scroll.y 不生效）
  > .ant-spin-nested-loading,
  > .ant-spin
    flex 1 1 0
    min-height 0
    display flex
    flex-direction column
    > .ant-spin-container
      flex 1 1 0
      min-height 0
      display flex
      flex-direction column

.db-sql-affected
  color var(--text)
  flex none

// Redis 键空间
.db-redis-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-redis-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-match
  flex 1 1 0
  min-width 120px
  max-width 360px

// 键列表/详情各 flex 1 1 0，具体比例由内联 flexBasis 驱动（可拖拽，默认平分）。
// ⚠️ 不能给固定 max-height：auto 高度 + 内部 basis 0 会把网格塌成 0（踩过）；
// 且固定比例无法适配键库规模差异
.db-redis-keys
  min-height 0
  // S6：键列表数据面字体与终端统一
  font-family var(--db-code-font, var(--font-mono))

// H7a-3：键树视图（与键列表同一块区域，两种视图互斥）
// ⚠️ antd 的 blockNode 只给 .ant-tree-node-content-wrapper flex: auto，
// flex 项默认 min-width auto —— 长键名会把行撑出横向滚动而不是截断，
// 所以必须逐层补 min-width: 0 才能把 ellipsis 传下去
.db-redis-tree
  flex 1 1 0
  min-height 0
  overflow auto
  // 键名是代码面文本，与键列表/终端同源
  font-family var(--db-code-font, var(--font-mono))

  .ant-tree-node-content-wrapper
    display flex
    align-items center
    min-width 0

  .ant-tree-title
    display flex
    align-items center
    flex 0 1 auto
    min-width 0

.db-redis-tree-node
  display flex
  align-items center
  gap 6px
  width 100%
  min-width 0

.db-redis-tree-title
  flex 0 1 auto
  min-width 0
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

// 计数是辅助信息：用 --text-muted 变色，不用 opacity（U2c 对比度契约）
.db-redis-tree-count
  flex none
  color var(--text-muted)
  font-variant-numeric tabular-nums

.db-redis-tree-empty
  display flex
  align-items center
  justify-content center
  min-height 120px

.db-redis-tree-sep
  display flex
  align-items center
  gap 4px
  flex none

.db-redis-tree-sep-label
  color var(--text-muted)

.db-redis-tree-sep-input
  width 64px

.db-redis-tree-status
  flex none
  color var(--text-muted)

  // 扫到上限=树只建了一部分，必须比"正常进度"更醒目
  &.is-truncated
    color var(--warn)

// H7a-4 Redis 服务器信息弹层
.db-redis-info
  // 概览分组：窄宽度自动折行，不会因为窗口小就横向挤成一列长条
  .db-redis-info-groups
    display flex
    flex-wrap wrap
    gap 12px
    align-items flex-start

  .db-redis-info-group
    // 260px 起：够放"已连接客户端 / 128"这样的标签+值，再窄就要折行影响扫读
    flex 1 1 260px
    min-width 240px
    max-width 340px
    border 1px solid var(--border)
    border-radius var(--radius-sm)
    padding 8px 10px

  .db-redis-info-group-title
    color var(--text-muted)
    font-size 12px
    margin-bottom 6px

  .db-redis-info-row
    display flex
    align-items baseline
    gap 8px
    line-height 20px

  .db-redis-info-k
    flex 0 0 auto
    // 标签固定 118px 起对齐，值再长短也落在同一条竖线上，扫读成本低
    min-width 108px
    color var(--text-muted)

  .db-redis-info-v
    flex 1 1 0
    min-width 0
    text-align right
    color var(--text-dark)
    font-family var(--db-code-font, var(--font-mono))
    font-variant-numeric tabular-nums

  .db-redis-info-raw
    max-height 46vh
    overflow auto
    margin 0
    padding 8px 10px
    border 1px solid var(--border)
    border-radius var(--radius-sm)
    background var(--hover-bg)
    color var(--text-dark)
    font-family var(--db-code-font, var(--font-mono))
    font-size 12px
    line-height 18px
    // 键名/路径这类长 token 不该撑出横向滚动条，让它按字符折
    white-space pre-wrap
    word-break break-all

  .db-redis-info-loading
  .db-redis-info-empty
    display flex
    align-items center
    justify-content center
    min-height 120px
    color var(--text-muted)

  // H7b-2 慢日志页签（同一个弹层、另一条命令）
  .db-redis-slowlog
    .db-redis-info-err
      margin-bottom 8px

  .db-redis-slowlog-status
    // 状态行放在表格上方而不是 footer：条数与最慢值是"这张表值不值得看"的第一眼判据
    margin-bottom 6px
    color var(--text-muted)
    font-size 12px

  .db-redis-slowlog-num
    // 耗时列：等宽 + tabular-nums，42.13 ms / 1.50 s 要能竖着比大小
    font-family var(--db-code-font, var(--font-mono))
    font-variant-numeric tabular-nums

  // 只右对齐数据格，表头不跟着走（与网格同一口径：表头右对齐会和列名阅读顺序打架）
  td.db-redis-slowlog-num
    text-align right

  .db-redis-slowlog-args
    font-family var(--db-code-font, var(--font-mono))
    color var(--text-dark)

// H7b-3 跨页勾选提示：勾选可能整页都不在当前页，这行是唯一"我还选着东西"的证据
.db-redis-sel-chip
  display inline-flex
  align-items center
  gap 2px
  color var(--text-muted)
  font-variant-numeric tabular-nums
  white-space nowrap

.db-redis-sel-clear
  padding 0 2px !important
  height auto !important

// H7b-3 批量删键弹层：键名是数据面（和键列表同一套等宽字体链），
// 长键名按字符截断而不是撑出横向滚动条
.db-redis-del
  .db-redis-del-note
    margin 0 0 8px
    color var(--text-dark)

  .db-redis-del-list
    max-height 220px
    overflow auto
    padding 6px 8px
    border 1px solid var(--border)
    border-radius var(--radius-sm)
    background var(--hover-bg)
    font-family var(--db-code-font, var(--font-mono))
    font-size 12px
    line-height 18px

  .db-redis-del-key
    overflow hidden
    white-space nowrap
    text-overflow ellipsis
    color var(--text)

  .db-redis-del-more
    margin-top 6px
    color var(--text-muted)

  .db-redis-del-prog
    margin-top 10px

  .db-redis-del-prog-text
    display inline-block
    margin-top 2px
    color var(--text-muted)
    font-variant-numeric tabular-nums

  .db-redis-del-err
    margin-top 10px

// 上下可拖拽分区（redis 键列表/详情、mysql 网格/单元格预览共用，DbSplitPane）
.db-split-pane
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.db-split-pane-top
.db-split-pane-bottom
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

// H1a-4 折叠态：top 吃满剩余高、bottom 按内容高（一条工具条），且不给 resizer。
// bottom 自身不留 padding/边框 —— 没选中单元格时它是空的，必须真的不占位。
.db-split-pane-collapsed
  > .db-split-pane-top
    flex 1 1 auto
  > .db-split-pane-bottom
    flex 0 0 auto

.db-split-resizer
  flex none
  position relative
  z-index 5
  height 9px
  cursor row-resize
  background transparent
  &::after
    content ''
    position absolute
    left 0
    right 0
    top 4px
    height 1px
    background transparent
    transition background var(--dur-1) var(--ease)
  &:hover::after
    background var(--primary)
  &:active::after
    background var(--primary)

// 分区空态占位（未选键/未选单元格）
.db-pane-empty
  align-items center
  justify-content center

// Redis 键列表的"当前键"高亮：与 antd 的行选中态同一口径（--active-bg）。
// td 那条留给非虚拟渲染（scroll.y 关掉时才是真 table），虚拟表体走 .ant-table-cell
.db-row-selected td,
.db-row-selected .ant-table-cell
  background var(--active-bg)

// 统一值预览/编辑面板（mysql 单元格、redis 键值共用，DbValuePane）
// height 100% 不是冗余：父级可能是 antd 的 pane（.ant-tabs-content，display block）
// 或 .db-redis-detail（block + overflow auto），都不是 flex 容器 → flex-basis 不生效，
// 面板高度退化为「内容高」。只读态 <pre> 自带内容高看不出问题，进编辑态后
// textarea 是 flex 1 1 0 + min-height 0，在 auto 高度父级下塌成 0（实测已踩）。
// 两种情况父级高度都是确定的，百分比能解析，所以直接给确定高度最稳。
.db-value-pane
  flex 1 1 0
  min-height 0
  height 100%
  display flex
  flex-direction column
  .db-value-pane-head
    display flex
    align-items center
    gap 8px
    padding 4px 8px
    flex none
  .db-value-pane-text
    flex 1 1 0
    min-height 0
    // antd 给 textarea 写死 width 100%，加上左右 margin 会横向溢出，
    // 父级 overflow auto 就会多出一条横向滚动条（编辑态凭空矮 15px）
    width auto
    margin 0 8px 8px
    font-family var(--db-code-font, var(--font-mono))
    font-size 12px

.db-value-pane-pre
  margin 0 8px 8px

// F3 二进制呈现器（hex/base64 已走 db-value-pane-pre 的高亮；下列为 image/blob-info 专用）
.db-value-bin-image
  margin 8px
  img
    max-width 100%
    max-height 240px
    background var(--main-light)
  .db-value-bin-meta
    margin-top 4px
    font-size 12px
    color var(--text-dark)
.db-value-bin-info
  white-space pre-wrap
  font-size 12px
  line-height 1.6
.db-value-bin-note
  margin 6px 8px
  font-size 12px
  color var(--warn)

.db-redis-detail
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px

// 未选键时的占位：Empty 在半区内居中
.db-redis-detail-empty
  align-items center
  justify-content center

.db-redis-more
  flex none
  align-self flex-start

.db-redis-detail-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-key-name
  max-width 40%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// H7b-4 Stream 详情（只读）：元信息条 + 消费组表 + 条目表
// 键名/ID/组名都是「要照着敲」的东西，走数据面字体链（--db-code-font），
// 没有就是等宽回落 —— 不要在弹层/详情里另起一套字号
// 撑满分区高度：条目表要拿确定高度才能内部滚动（与 hash/list 详情同一个前提），
// 写成 flex none 的话它的 flex-basis 0 在 auto 高度父级里塌成 0 → 整张表看不见
.db-redis-stream
  display flex
  flex-direction column
  gap 6px
  flex 1 1 0
  min-height 0

// 消费组通常个位数：不给弹性高度，最多 180px 自己滚
.db-redis-stream-groups-table
  flex none
  max-height 180px

// 值面板打开 = 上下分区只剩一半高度，消费组让位给条目表（组数仍在元信息条里）
.db-redis-stream-compact
  .db-redis-stream-groups-head
  .db-redis-stream-groups-table
    display none

.db-redis-stream-entries-table
  flex 1 1 0
  min-height 0

.db-redis-stream-meta
  display flex
  align-items center
  flex-wrap wrap
  gap 12px
  padding 6px 0
  border-bottom 1px solid var(--border)
  color var(--text)
  font-size 12px

.db-redis-stream-stat
  display inline-flex
  align-items baseline
  gap 4px

.db-redis-stream-k
  color var(--text-muted)

.db-redis-stream-v
  color var(--text)

.db-redis-stream-mono
  font-family var(--db-code-font, var(--font-mono))

.db-redis-stream-refresh
  margin-left auto

.db-redis-stream-head
  display flex
  align-items center
  gap 8px
  margin-top 2px

.db-redis-stream-title
  font-size 12px
  font-weight 500
  color var(--text)

.db-redis-stream-note
  font-size 12px
  color var(--text-muted)

// 表结构区（列定义网格）：撑满 tabpane（块级父级里 flex-basis 不生效，必须 height 100%），
// flex 列布局让 .db-grid-table-wrap 拿到确定高度并内部滚动
.db-struct-area
  height 100%
  min-height 0
  display flex
  flex-direction column
  overflow hidden

// 连接失败卡片：标题 + 目标 + 原因 + 原始错误 + 重连/复制
// （页面级：初次建连失败；区级 banner：操作中掉线）
.db-conn-fail
  max-width 560px
  padding 12px 14px
  border-radius var(--radius-sm)
  background var(--error-bg)
  box-shadow inset 3px 0 0 0 var(--error)
  color var(--text)

.db-conn-fail-banner
  flex none
  max-width none
  margin-bottom 8px

.db-conn-fail-head
  display flex
  align-items center
  gap 6px
  margin-bottom 8px
  color var(--error)
  font-weight 500

.db-conn-fail-row
  display flex
  gap 8px

.db-conn-fail-key
  flex none
  min-width 52px
  opacity .65

.db-conn-fail-val
  word-break break-all

// 原始错误：等宽 + 可滚动，方便复制给同事/工单，但不抢主信息
.db-conn-fail-raw
  margin 8px 0
  padding 6px 8px
  border-radius var(--radius-xs)
  background unquote('color-mix(in srgb, var(--main) 55%, transparent)')
  color var(--text-dark)
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  max-height 96px
  overflow auto
  word-break break-all

.db-conn-fail-actions
  display flex

// 多结果集：每个结果集一块（含 affected 行 + 网格）
// flex 撑满：让内部 .db-grid-table-wrap 拿到确定高度（scroll.y 生效的前提）
//
// height 100% 不是冗余：多结果集时本节点的父级是 Tabs 的 pane
// （.ant-tabs-content，display block），flex-grow 在非 flex 容器里完全不生效
// → 节点高度退化为「内容高」，而 .db-grid-table-wrap 是 flex 1 1 0 + overflow hidden，
// 在 auto 高度父级下主尺寸塌成 0 → 表格被整块裁掉（tools 行还看得见，
// 所以现象是「有下载按钮、没有表格」）。实测 pane 354px 时 wrap 为 0。
// 单结果集时父级是 .db-sql-result（flex column），flex 属性生效、height 被 flex-basis 覆盖，
// 两条路径互不干扰。
// 注意不要改成给 pane 加 display flex：antd 用 .ant-tabs-content-hidden 的
// display none 隐藏非激活面板，特异性低于本文件的选择器，会被一起覆盖掉。
.db-sql-result-one
  display flex
  flex-direction column
  gap 4px
  flex 1 1 0
  min-height 0
  height 100%

.db-sql-results-tabs
  flex 1 1 0
  min-height 0

// S3-B：SQL 结果工具行（左上角：分页 + 行数选择 + 导出，同一排、靠左）
// 分页器原在表尾，结果区最下方会被底部快捷命令栏遮住（2026-10-28 实测截图），
// 上移到工具行；不挤压网格（flex column 里按内容高）。
.db-sql-result-tools
  display flex
  justify-content flex-start
  align-items center
  flex-wrap wrap
  gap 8px
  min-height 24px

// H1：SQL 结果的过滤输入与"命中/总数"。宽度取设计区间 180~260 的中位；
// 命中 0 用错误色 —— 工具行里"筛没了"必须一眼看出来，否则会被当成查询没跑
.db-sql-filter
  width 200px

.db-sql-filter-hit
  font-size 12px
  color var(--text-dark)

.db-sql-filter-hit-empty
  color var(--error)

// H1：表头排序。指示符绝对定位在右边沿拖拽热区（16px）左侧 —— 放进文字行会
// 被 .db-col-name 的 ellipsis 裁掉，也会把窄列的列名挤没。
// 未排序时给个淡的 ⇅ 提示"这一列可点"，排序后换成实心箭头 + 主色
.db-col-head-sortable
  padding-right 14px
  cursor pointer
  user-select none

  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset 2px

.db-col-sort
  position absolute
  top 3px
  right 18px
  font-size 10px
  line-height 1
  opacity 0.35
  pointer-events none

.db-col-sort-active
  opacity 1
  color var(--primary)

// 排序列补一道主色下划线（U2）：箭头只有 10px，宽表里横向扫视时看不出"当前按哪列排的"。
// 自绘箭头之后表头格上没有 antd 的排序类名（74ef3fdd 起不再借 antd sorter），
// 所以用 :has() 从箭头反推它所在的表头格。下划线是非文本指示物，门槛 3:1，
// 实测 --primary(#08c) 在深色表头 4.46:1、浅色 3.24:1 —— 达标，且与箭头同色不引第二套色。
// 写法用契约里的"功能指示条"四值形式（css-radius-shadow 白名单），别自创三值
.db-grid-table
  th.ant-table-cell:has(.db-col-sort-active)
    box-shadow inset 0 -2px 0 0 var(--primary)

.db-sql-sort-hint
  font-size 12px
  color var(--text-dark)

// 列显隐下拉：列多时弹层自己滚，不把页面撑长；列名过长省略号
.db-sql-cols-menu
  max-height 320px
  overflow-y auto

  .db-sql-cols-item
    display inline-block
    max-width 260px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    vertical-align middle

// 结果网格的可见边框（H1a-4 提为共享 class）：与左侧树面板同款。同色背景下
// 没有边界时，看不出结果区是否真的避开了底部快捷命令栏（2026-10-28 用户反馈）。
// SQL 结果网格与数据页主网格都挂 .is-bordered
.db-grid-table-wrap.is-bordered
  border 1px solid var(--border)
  border-radius var(--radius-sm)

// SQL 结果专属：margin-bottom 与 .db-body 的 8px 内边距叠加，
// 结果框与快捷命令栏之间留 12px
.db-grid-table-wrap.db-sql-result-grid
  margin-bottom 4px

// 工具行右侧状态行：{rows} 行 · {ms} ms。margin-left auto 顶到工具行右沿；
// 12px 次要色 —— 是参考信息，不能跟分页器/过滤框抢视觉
.db-sql-elapsed
  margin-left auto
  font-size 12px
  color var(--text-dark)
  white-space nowrap

// S3-C：SQL 执行历史弹层
// 尺寸由 JS 内联给（可拖拽 + 持久化），这里的 width/height 只是"JS 没给值"时的兜底
.db-history-pop
  width 720px
  height 440px
  display flex
  flex-direction column
  position relative
  min-width 0
  min-height 0

.db-history-head
  display flex
  align-items center
  justify-content space-between
  padding 0 4px 6px
  border-bottom 1px solid var(--border)
  font-weight 500

.db-history-title
  display flex
  align-items center
  gap 6px

.db-history-count
  padding 0 5px
  border-radius var(--radius-xs)
  background var(--hover-bg)
  color var(--text-dark)
  font-size 11px
  font-weight 400

// 筛选框：与列表同宽，右侧同样让出 6px 给拖拽把手
.db-history-filter
  flex 0 0 auto
  margin 6px 6px 0 0

// 列表 + 预览两栏：够宽左右排，窄了改上下（< 600px 时两栏各自都会被折到不可读）
.db-history-body
  display flex
  flex 1 1 auto
  // 右侧让出 6px：拖拽把手贴在弹层右边缘，不能压住列表滚动条
  padding-right 6px
  min-height 0
  gap 8px

.db-history-pop[data-split='col'] .db-history-body
  flex-direction column

.db-history-list
  // 容器高度由内联 style 钉死（不再靠 max-height），basis 0 才不会塌——
  // 老写法 flex 0 1 auto 是给"仅 max-height"的容器用的，现在反而会让列表
  // 按内容撑高把预览栏挤出去
  flex 1 1 0
  min-height 0
  overflow-y auto
  outline none
  &:focus-visible
    outline 1px solid var(--primary)
    outline-offset -1px

.db-history-item
  position relative
  padding 6px 8px 6px 6px
  border-left 2px solid transparent
  border-radius var(--radius-sm)
  cursor pointer
  &:hover
    background var(--hover-bg)
  &.is-active
    background var(--hover-bg)
    border-left-color var(--primary)
  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset -2px

// 列表里只露两行：一条语句可能几十行，全展开会把列表挤没；
// 完整内容看右侧预览栏（悬浮即切换）
.db-history-sql
  display -webkit-box
  -webkit-line-clamp 2
  -webkit-box-orient vertical
  overflow hidden
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  word-break break-all

.db-history-meta
  display flex
  gap 8px
  align-items center
  margin-top 2px
  color var(--text-dark)
  font-size 11px
  // 勾选框式的操作区占位后，时间/来源可能被压到折行（"失/败"竖排两个字）；
  // 只让来源那一项收缩省略，其余保持单行
  white-space nowrap
  min-width 0

.db-history-time
.db-history-fail
  flex 0 0 auto

.db-history-src
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// 条目右下角的操作组（复制 / 删除）：常驻占位、只切透明度——
// 显隐若用 display 切换，元信息行会跟着抖动，悬浮时正文跟着跳
.db-history-ops
  display flex
  align-items center
  gap 2px
  margin-left auto
  opacity 0
  .db-history-item:hover &
    opacity 1
  .db-history-item.is-active &
    opacity 1

.db-history-copy
  // 去掉 antd 文本按钮的横向内边距：两个 20px 的图标挤在一起才不撑宽元信息行
  padding 0 2px
  height 18px

// 历史条目内的一键收藏星标 / 分组下拉箭头（与复制/删除同款紧凑尺寸）
.db-history-star
  padding 0 2px
  height 18px

// 历史头部右侧操作组（导出 + 清空）
.db-history-headops
  display flex
  align-items center
  gap 2px

// 删除：鼠标悬浮才露出的 X。
// 危险色交给 antd 的 danger 语义（hover 自带红字 + 淡红底），不在这一层写 :hover color——
// antd 的 text-button hover 规则是 `:where(...).ant-btn:not(:disabled):not(.ant-btn-disabled):hover`
// （0,4,0），类选择器压不住，写了也不生效（test.259 实测 hover 后变成近黑色，深色主题下看不见）
.db-history-del
  padding 0 2px
  height 18px

.db-history-fail
  color var(--error)

.db-history-empty
  padding 16px 8px
  text-align center
  color var(--text-dark)
  flex 1 1 auto

.db-history-note
  // 右侧让出 14px：右下角的拖拽把手压在弹层角上，注释文字别钻到它底下
  padding 6px 14px 0 4px
  border-top 1px solid var(--border)
  color var(--text-dark)
  font-size 11px

// 预览栏
.db-history-preview
  display flex
  flex-direction column
  flex 1 1 0
  min-width 0
  min-height 0
  padding-left 8px
  border-left 1px solid var(--border)

.db-history-pop[data-split='col'] .db-history-preview
  // 上下布局时预览固定占 40%，列表仍有 60% 可滚
  flex 0 0 40%
  padding-left 0
  padding-top 6px
  border-left none
  border-top 1px solid var(--border)

.db-history-preview-head
  display flex
  align-items center
  justify-content space-between
  padding-bottom 4px
  color var(--text-dark)
  font-size 11px

.db-history-preview-code
  flex 1 1 0
  min-height 0
  margin 0
  overflow auto
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  // pre-wrap 保换行与缩进（预览就是"原样长什么样"），长单词强制断行防横向滚动
  white-space pre-wrap
  word-break break-word
  tab-size 2

// 拖拽把手：右边缘改宽、右下角改宽高
.db-history-rz
  position absolute
  z-index 2
  -webkit-app-region no-drag

.db-history-rz-r
  top 0
  right 0
  width 6px
  bottom 16px
  cursor ew-resize

.db-history-rz-c
  right 0
  bottom 0
  width 14px
  height 14px
  cursor nwse-resize
  // 三道斜线做视觉提示（纯 CSS，不占 DOM）
  background linear-gradient(
    135deg,
    transparent 0 46%,
    var(--text-dark) 46% 52%,
    transparent 52% 62%,
    var(--text-dark) 62% 68%,
    transparent 68%
  )
  opacity 0.45
  &:hover
    opacity 0.9

// 拖拽期间禁选中：否则弹层里的语句文本会被刷成蓝色选中态
body.db-hist-resizing
  user-select none

// A-8：编辑器选项弹层
.db-sql-opts-pop
  width 220px

.db-sql-opts-head
  padding 0 4px 6px
  margin-bottom 4px
  border-bottom 1px solid var(--border)
  font-weight 500

.db-sql-opt-row
  display flex
  align-items center
  gap 8px
  padding 5px 4px
  border-radius var(--radius-sm)
  cursor pointer
  &:hover
    background var(--hover-bg)
  // popover 里 Switch 自带 4px 左右内距，行高统一靠这里压住
  .ant-switch
    flex 0 0 auto

.db-sql-opt-label
  flex 1 1 auto
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  font-size 12px

.db-sql-opts-note
  margin-top 6px
  padding 6px 4px 0
  border-top 1px solid var(--border)
  color var(--text-dark)
  font-size 11px

// ---- E1 危险 SQL 分级 / 连接级安全带（设计 §6.4）----
// 颜色一律走主题 token（--error / --warn / --info 及对应的 *-bg 混色）。
// 硬编码色值会在换主题后变成脏点，且与终端配色脱节

// 生产连接常驻标记：放顶部工具条（唯一跨 tab 常驻的位置）
.db-prod-flag
  flex none
  padding 0 6px
  border 1px solid var(--error)
  border-radius var(--radius-pill)
  background var(--error-bg)
  color var(--error)
  font-size 11px
  font-weight 600
  line-height 16px
  letter-spacing 0.5px
  cursor default

// 临时解除按钮：生效期用危险色描边提示"现在没有保护"
.db-prod-bypass
  flex none
  font-size 12px
  &.is-on
    color var(--error)
    border-color var(--error)

// Tooltip 的挂载点。`.db-head-right` 是 flex 容器，span 作为 flex item 会被拉成
// 块级宽度，点击/悬停热区跟着变成整行；inline-flex 让它贴合按钮实际尺寸。
.db-prod-bypass-wrap
  display inline-flex

.db-risk-title
  display flex
  align-items center
  gap 8px
  flex-wrap wrap
  // antd 的关闭按钮是绝对定位（宽 32px）贴在标题右边的，标题本身必须让出这块宽度，
  // 否则 `2 statement(s) will…` 会被 X 压掉尾部。36 = 32 按钮 + 4 呼吸位，
  // 实测（Electron 760x720）计数右边缘比关闭按钮左边缘早 4px
  padding-right 36px

.db-risk-badge
  display inline-flex
  align-items center
  height 20px
  padding 0 8px
  border-radius var(--radius-pill)
  border 1px solid var(--border)
  font-size 12px
  font-weight 600
  line-height 20px

.db-risk-badge-dangerous
  border-color var(--error)
  background var(--error-bg)
  color var(--error)

.db-risk-badge-ddl
  border-color var(--warn)
  background var(--warn-bg)
  color var(--warn)

.db-risk-badge-write
  border-color var(--info)
  background var(--info-bg)
  color var(--info)

.db-risk-badge-unknown
.db-risk-badge-transaction
.db-risk-badge-read
  color var(--text-dark)

.db-risk-env
  padding 0 6px
  border-radius var(--radius-pill)
  background var(--error)
  color var(--text-light)
  font-size 11px
  line-height 16px
  font-weight 600

.db-risk-count
  margin-left auto
  color var(--text-dark)
  font-size 12px

.db-risk-body
  display flex
  flex-direction column
  gap 12px
  max-height 60vh
  overflow auto

.db-risk-sec
  display flex
  flex-direction column
  gap 6px

// 「为什么要问你」那一行：回答的是"这次为什么拦"，不是"这条 SQL 哪里危险"。
// 刻意用灰度正文色 + 12px（与 .db-risk-sec-title 同字号但不加粗），
// 让它在视觉上从属于下方的"判定理由"小节，而不是抢成一等标题。
.db-risk-gate-reason
  color var(--text)
  font-size 12px
  line-height 1.5

.db-risk-sec-title
  color var(--text-dark)
  font-size 12px
  font-weight 600

.db-risk-reason-list
  margin 0
  padding-left 18px
  color var(--text)
  font-size 13px

.db-risk-reason
  line-height 1.6

.db-risk-stmts
  display flex
  flex-direction column
  gap 8px

.db-risk-stmt
  border 1px solid var(--border)
  border-radius var(--radius-xs)
  overflow hidden

.db-risk-stmt-head
  display flex
  align-items center
  gap 8px
  padding 2px 6px
  background var(--hover-bg)

.db-risk-stmt-no
  min-width 14px
  color var(--text-dark)
  font-size 11px

.db-risk-stmt-lv
  color var(--text-dark)
  font-size 11px
  &.db-risk-lv-dangerous
    color var(--error)
  &.db-risk-lv-ddl
    color var(--warn)
  &.db-risk-lv-write
    color var(--info)

.db-risk-stmt-toggle
  margin-left auto

// 默认只露两行：一条几十行的语句会把弹窗撑到屏幕外，
// 用户反而够不着"仍要执行"，只能盲点。
// ⚠️ 纵向留白只能用 margin 不能用 padding：line-clamp 只裁内容行盒，
// 一旦有纵向 padding，被裁掉的第 3 行上半截会从 padding 区露出来（实测出现"半行"）
.db-risk-stmt-text
  display -webkit-box
  -webkit-box-orient vertical
  -webkit-line-clamp 2
  margin 6px 0
  padding 0 8px
  overflow hidden
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px

.db-session-wrap
  display flex
  flex-direction row
  height 100%
  width 100%
  overflow hidden
  padding 8px
  gap 8px

.db-session-loading
  display flex
  align-items center
  gap 8px
  min-height 200px

.db-session-loading-text
  color var(--text)

// 左侧元数据树
.db-tree-panel
  flex none
  width 240px
  min-width 180px
  height 100%
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  padding 4px

.db-tree-head
  display flex
  align-items center
  justify-content space-between
  padding 2px 4px

.db-tree-title
  color var(--text)
  font-weight 500

// 右侧主区
.db-main-panel
  flex 1 1 0
  min-width 0
  height 100%
  display flex
  flex-direction column
  overflow hidden

.db-grid-area
  display flex
  flex-direction column
  height 100%
  overflow hidden

.db-grid-head
  display flex
  align-items center
  justify-content space-between
  padding 0 4px 8px

.db-grid-title
  color var(--text)
  font-weight 500

.db-grid-pager
  display flex
  align-items center
  gap 8px

.db-grid-page-no
  color var(--text)

.db-grid-table
  flex 1 1 0
  min-height 0
  overflow auto

.db-cell-null
  color var(--text)
  opacity 0.5

// 主区 Tabs：去掉默认 margin，内容区撑满
.db-tabs
  height 100%
  display flex
  flex-direction column
  &.ant-tabs
    > .ant-tabs-nav
      margin 0 0 8px
    > .ant-tabs-content-holder
      flex 1 1 0
      min-height 0
      overflow hidden
      > .ant-tabs-content
        height 100%
        > .ant-tabs-tabpane
          height 100%

// SQL 编辑器区
.db-sql-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-sql-editor
  flex none
  font-family var(--font-mono)

.db-sql-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-sql-result
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px

.db-sql-affected
  color var(--text)
  flex none

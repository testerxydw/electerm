.db-session-wrap
  display flex
  flex-direction column
  height 100%
  width 100%
  overflow hidden
  // S6：数据面禁连字，防 0/O、l/1、=>/≠ 等视觉混淆（对非数据面文本无副作用）
  font-variant-ligatures none

// 顶部工具条：引擎/目标/状态 + 只读/刷新。
// 高度口径 = tokens.styl --session-bar-h（与 .terminal-control 统一；
// session/sessions.jsx 的扣减依赖该值，JS 侧镜像见 constants.js termControlHeight）
.db-head
  flex none
  height var(--session-bar-h)
  display flex
  align-items center
  gap 8px
  padding 0 10px
  border-bottom 1px solid var(--border)
  font-size 12px

.db-head-engine
  flex none
  padding 0 6px
  border-radius var(--radius-sm)
  background var(--hover-bg)
  line-height 18px

.db-head-target
  min-width 0
  color var(--text-dark)

.db-head-state
  flex none
  display flex
  align-items center
  gap 4px
  color var(--text-dark)

.db-head-dot
  width 6px
  height 6px
  border-radius var(--radius-pill)
  background var(--success)
  &.err
    background var(--error)

// 只读/刷新紧跟在连接信息之后（左起排列），不推到工具条最右端
.db-head-right
  display flex
  align-items center
  gap 6px

// 窗口级动作（查找/全屏）：靠右，与终端顶栏 SessionControl 右侧控件同位置同口径
// （S1 起图标本体来自 common/session-bar-actions.jsx，激活态类 .search-open 全局共用）
.db-head-actions
  margin-left auto
  display flex
  align-items center
  gap 6px
  color var(--text-dark)

// 查找命中标记：非当前 = 弱化品牌色；当前 = 主色 + 外描边（颜色走 token：CSS 契约禁止裸色值）
.db-kw-hit
  background var(--accent-wash)
  color var(--text)
  &.db-kw-cur
    background var(--primary)
    color var(--primary-contrast)
    outline 1px solid var(--primary-contrast)
  border-radius var(--radius-xs)

// 左右分栏容器（树 | 拖拽条 | 主区）：原 .db-session-wrap 的内边距搬到这里
.db-body
  flex 1 1 0
  min-height 0
  display flex
  flex-direction row
  padding 8px
  gap 8px
  overflow hidden

// 错误态：不沿用 .db-session-wrap 的 flex 行布局，避免 Alert 被拉伸满屏
.db-session-error
  display block
  padding 12px

.db-session-loading
  display flex
  align-items center
  gap 8px
  min-height 200px

.db-session-loading-text
  color var(--text)

// 左侧元数据树
.db-tree-panel
  flex none
  // 宽度由内联样式驱动（可拖拽调整，见 .db-tree-resizer），此处只约束范围
  min-width 160px
  max-width 600px
  height 100%
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  padding 4px
  // 容器是圆角、全局滚动条 thumb 是直角，滚动到两端时与圆角相切/被裁；
  // 这里让 thumb 也圆角，并用 1px 透明边框 + content-box 裁切使其内缩，避免贴角
  &::-webkit-scrollbar-thumb
    border-radius var(--radius-xs)
    border 1px solid transparent
    background-clip content-box

// 拖拽条：命中区骑跨在左侧容器右边框上，因此"拖的就是容器边缘"，
// 而不是浮在面板与主区之间的独立竖条。
// 定位算术：margin-left = -(gap 8 + 半宽 4) = -12 → 左边缘落在边框左 4px；
// margin-right = +12 补回，净占位仍是 9px，故右侧主区位置与改动前完全一致。
.db-tree-resizer
  flex none
  position relative
  z-index 5
  width 9px
  margin 0 12px 0 -12px
  cursor col-resize
  background transparent
  &::after
    content ''
    position absolute
    top 0
    bottom 0
    left 4px
    width 1px
    background transparent
    transition background var(--dur-1) var(--ease)
  &:hover::after
    background var(--primary)
  &:active::after
    background var(--primary)

// Redis 数据库节点：名称居左、键个数居右
.db-tree-db
  display flex
  align-items center
  justify-content space-between
  gap 8px
  width 100%

.db-tree-db-count
  color var(--text-dark)
  font-size 12px
  font-variant-numeric tabular-nums

// mysql 元数据 per-db 降级标记（单库 SHOW TABLES 失败，悬停见错误详情）
.db-tree-db-err
  color var(--error)
  margin-left 5px
  font-weight bold

// 工具条"系统库"显示开关（label + Switch）
.db-sys-toggle
  display inline-flex
  align-items center
  margin-right 8px
.db-sys-toggle-label
  color var(--text-dark)
  font-size 12px
  margin-right 4px
  white-space nowrap

// 右侧主区
.db-main-panel
  flex 1 1 0
  min-width 0
  height 100%
  display flex
  flex-direction column
  overflow hidden

.db-grid-area
  display flex
  flex-direction column
  height 100%
  overflow hidden

// 表名 + 行数估算 + 翻页 + 刷新：一条左对齐的控制条（与 Redis 的 .db-redis-bar 同款），
// 不用 space-between 把控件摊到整行两端
.db-grid-head
  display flex
  align-items center
  gap 8px
  padding 0 4px 8px
  min-width 0

.db-grid-title
  color var(--text)
  font-weight 500
  // 表名过长时截断，不挤走后面的控件
  max-width 45%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.db-grid-pager
  display flex
  align-items center
  gap 8px

.db-grid-page-no
  color var(--text)

// 页码快速跳转标签（当前页 ±1 + 首/末页 + 省略号）
.db-grid-page-tags
  display flex
  align-items center
  gap 4px

// 跳页输入
.db-grid-jump
  width 72px

// 近似总行数（次要信息）
.db-grid-total
  color var(--text-dark)
  font-size 12px

// 取数失败：错误落在表格区内（不再只 toast）
.db-grid-error
  flex none
  margin-bottom 8px

// 空表提示
.db-empty-tip
  color var(--text-dark)

// 主数据网格滚动容器（仅数据 tab 的表格用）：
// 滚动权交给 antd 内部表体（scroll.y 定高），横向滚动条常驻可视区底边、表头吸顶
// （见 doc/数据库表格横向滚动条优化方案.md）；其余 Table（SQL 结果/表结构/Redis）仍走 .db-grid-table 旧滚动
.db-grid-table-wrap
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.db-grid-table
  // basis 用 auto 而非 0：wrap 定高（主网格等）时效果相同，
  // 但在 auto 高度的 wrap 里（如 .db-redis-keys 的 max-height 45%）不会把内容高缩成 0
  flex 1 1 auto
  min-height 0
  overflow auto
  // S6：网格单元格数据面字体与终端统一
  font-family var(--db-code-font, var(--font-mono))

.db-cell-null
  color var(--text)
  opacity 0.5

// 关键字高亮（.db-kw）颜色由终端主题决定，在 db-highlight.jsx 里以内联 style 上色，
// 这里不再写死色值（CSS 契约：非 includes 目录禁止硬编码颜色）

// 可编辑单元格（非只读且有主键）：hover 细线提示"可双击编辑"
// 作用在 td 上（onCell），因此整格留白也是双击命中区
// 用 outline 而非 box-shadow：CSS 契约禁止 box-shadow 里的 px 字面量
.db-cell-editable
  cursor text
  &:hover
    outline 1px solid var(--primary)
    outline-offset -1px

.db-cell-editor
  width 100%

// 值预览（原文 / 格式化都走这里）：等宽、可滚动、可选中复制，内容已按关键字高亮
.db-value-pre
  flex 1 1 auto
  min-height 0
  margin 0
  padding 6px 8px
  overflow auto
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  background var(--main)
  color var(--text)
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  line-height 1.5
  white-space pre-wrap
  word-break break-all
  user-select text

// 主区 Tabs：antd6 的内容层级为 body-holder > body > content，逐层撑满
// （.db-sql-results-tabs 是 SQL 多结果集分栏，同一撑满链路）
.db-tabs, .db-sql-results-tabs
  height 100%
  display flex
  flex-direction column
  &.ant-tabs
    > .ant-tabs-nav
      margin 0 0 8px
    > .ant-tabs-body-holder
      flex 1 1 0
      min-height 0
      overflow hidden
      > .ant-tabs-body
        height 100%
        > .ant-tabs-content
          height 100%

// SQL 编辑器区
.db-sql-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-sql-editor
  flex none
  font-family var(--db-code-font, var(--font-mono))

.db-sql-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-sql-result
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px
  // 结果外层的 antd Spin 包装层必须参与 flex 传高，
  // 否则内部 .db-grid-table-wrap 拿不到确定高度（scroll.y 不生效）
  > .ant-spin-nested-loading,
  > .ant-spin
    flex 1 1 0
    min-height 0
    display flex
    flex-direction column
    > .ant-spin-container
      flex 1 1 0
      min-height 0
      display flex
      flex-direction column

.db-sql-affected
  color var(--text)
  flex none

// Redis 键空间
.db-redis-area
  display flex
  flex-direction column
  height 100%
  overflow hidden
  gap 8px

.db-redis-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-match
  flex 1 1 0
  min-width 120px
  max-width 360px

// 键列表/详情各 flex 1 1 0，具体比例由内联 flexBasis 驱动（可拖拽，默认平分）。
// ⚠️ 不能给固定 max-height：auto 高度 + 内部 basis 0 会把网格塌成 0（踩过）；
// 且固定比例无法适配键库规模差异
.db-redis-keys
  min-height 0
  // S6：键列表数据面字体与终端统一
  font-family var(--db-code-font, var(--font-mono))

// 上下可拖拽分区（redis 键列表/详情、mysql 网格/单元格预览共用，DbSplitPane）
.db-split-pane
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.db-split-pane-top
.db-split-pane-bottom
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  overflow hidden

.db-split-resizer
  flex none
  position relative
  z-index 5
  height 9px
  cursor row-resize
  background transparent
  &::after
    content ''
    position absolute
    left 0
    right 0
    top 4px
    height 1px
    background transparent
    transition background var(--dur-1) var(--ease)
  &:hover::after
    background var(--primary)
  &:active::after
    background var(--primary)

// 分区空态占位（未选键/未选单元格）
.db-pane-empty
  align-items center
  justify-content center

.db-row-selected td
  background var(--active-bg)

// 统一值预览/编辑面板（mysql 单元格、redis 键值共用，DbValuePane）
.db-value-pane
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  .db-value-pane-head
    display flex
    align-items center
    gap 8px
    padding 4px 8px
    flex none
  .db-value-pane-text
    flex 1 1 0
    min-height 0
    margin 0 8px 8px
    font-family var(--db-code-font, var(--font-mono))
    font-size 12px

.db-value-pane-pre
  margin 0 8px 8px

.db-redis-detail
  flex 1 1 0
  min-height 0
  overflow auto
  display flex
  flex-direction column
  gap 4px

// 未选键时的占位：Empty 在半区内居中
.db-redis-detail-empty
  align-items center
  justify-content center

.db-redis-more
  flex none
  align-self flex-start

.db-redis-detail-bar
  display flex
  align-items center
  gap 8px
  flex none

.db-redis-key-name
  max-width 40%
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// 表结构区（列定义网格）：撑满 tabpane（块级父级里 flex-basis 不生效，必须 height 100%），
// flex 列布局让 .db-grid-table-wrap 拿到确定高度并内部滚动
.db-struct-area
  height 100%
  min-height 0
  display flex
  flex-direction column
  overflow hidden

// 连接失败卡片：标题 + 目标 + 原因 + 原始错误 + 重连/复制
// （页面级：初次建连失败；区级 banner：操作中掉线）
.db-conn-fail
  max-width 560px
  padding 12px 14px
  border-radius var(--radius-sm)
  background var(--error-bg)
  box-shadow inset 3px 0 0 0 var(--error)
  color var(--text)

.db-conn-fail-banner
  flex none
  max-width none
  margin-bottom 8px

.db-conn-fail-head
  display flex
  align-items center
  gap 6px
  margin-bottom 8px
  color var(--error)
  font-weight 500

.db-conn-fail-row
  display flex
  gap 8px

.db-conn-fail-key
  flex none
  min-width 52px
  opacity .65

.db-conn-fail-val
  word-break break-all

// 原始错误：等宽 + 可滚动，方便复制给同事/工单，但不抢主信息
.db-conn-fail-raw
  margin 8px 0
  padding 6px 8px
  border-radius var(--radius-xs)
  background unquote('color-mix(in srgb, var(--main) 55%, transparent)')
  color var(--text-dark)
  font-family var(--db-code-font, var(--font-mono))
  font-size 12px
  max-height 96px
  overflow auto
  word-break break-all

.db-conn-fail-actions
  display flex

// 多结果集：每个结果集一块（含 affected 行 + 网格）
// flex 撑满：让内部 .db-grid-table-wrap 拿到确定高度（scroll.y 生效的前提）
.db-sql-result-one
  display flex
  flex-direction column
  gap 4px
  flex 1 1 0
  min-height 0

.db-sql-results-tabs
  flex 1 1 0
  min-height 0

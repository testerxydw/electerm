.main-footer
  background var(--surface-1)
  height var(--footer-h)
  box-shadow inset 0 1px 0 0 var(--border)
  position absolute
  // 常驻让位左侧图标栏（图标栏直通窗口底部）；左缘与标签栏/终端列同源，
  // 不能额外 +1px（会与上方列错开 1px）。左侧面板宽度由
  // quick-commands-box.jsx 的 qmStyle.left 动态避让, 不在此固定
  left var(--left-side-bar-width, 43px)
  right 0
  // 底栏三合一：statusbar/kbar 已并入本条，直接贴底
  bottom 0
  z-index 200

.terminal-footer-flex
  display flex
  .terminal-footer-unit .ant-select-selector .ant-select-selection-placeholder
    line-height 24px

// 底栏三合一：左区会话状态（原 statusbar 内容并入，样式随迁）
// 可收缩截断：窄窗时先牺牲状态文本，右区按钮永不缩
.terminal-footer-status
  flex 0 1 auto
  min-width 0
  overflow hidden
  display flex
  align-items center
  gap 14px
  padding-left 12px
  font-size 11px
  font-family var(--font-mono)
  color var(--text-dark)
  white-space nowrap

.statusbar-unit
  display inline-flex
  align-items center
  gap 6px
  white-space nowrap

// 主机名加粗（对齐草图 .statusbar .it b）
.statusbar-host
  color var(--text)
  font-weight 600

.statusbar-dot
  width 6px
  height 6px
  border-radius var(--radius-pill)
  background var(--text-disabled)
  &.ok
    background var(--success)
  &.err
    background var(--error)

// 底栏三合一：右区全局动作（原 app-kbar 独有项），分隔线与中区按钮区分
.terminal-footer-global
  flex none
  display flex
  align-items center
  gap 4px
  margin-left 10px
  padding-left 10px
  border-left 1px solid var(--border)
  .terminal-footer-global-item
    display inline-flex
    align-items center
    justify-content center
    width 24px
    height 24px
    font-size 13px
    color var(--text-dark)
    cursor pointer
    border-radius var(--radius-xs)
    transition color var(--dur-1) var(--ease), background var(--dur-1) var(--ease)
    &:hover
      color var(--text-light)
      background var(--hover-bg)
    &:focus-visible
      box-shadow inset 0 0 0 1px var(--primary)
      outline none

.terminal-footer-unit
  margin-left 10px
  line-height var(--footer-h)
  textarea.ant-input
    min-height 26px
    height 26px
    margin-bottom -2px
    resize none
    &::-webkit-scrollbar
      width 0

// 传输/监控按钮：面板打开时与 AI 图标同款"点亮"色
.terminal-transfer-icon
.terminal-monitor-icon
  transition color var(--dur-1) var(--ease)
  &.active
    color var(--success)

.terminal-footer-center
  flex-grow 1
// 底栏快速命令带：占满批量输入之后的中部空白，命令多时带内横向滚动
// flex-basis 0：只分配剩余空间，胶囊内容再宽也不挤压左侧状态区（basis auto 会参与收缩挤压）
.quick-cmd-strip-unit
  flex 1 1 0
  min-width 0
  display flex
  align-items center
  overflow hidden
// 命令带存在时批量输入单元退为内容宽，剩余空白让给命令带
.terminal-footer-center:has(+ .quick-cmd-strip-unit)
  flex-grow 0
.quick-cmd-strip
  display flex
  align-items center
  min-width 0
  width 100%
  gap 6px
  font-size 12px
  color var(--text-dark)
.qcs-group-switch
  flex none
  display inline-flex
  align-items center
.qcs-arrow
  display inline-flex
  align-items center
  justify-content center
  width 16px
  height 22px
  color var(--text-dark)
  border-radius var(--radius-xs)
  transition color var(--dur-1) var(--ease), background var(--dur-1) var(--ease)
  &:hover
    color var(--text-light)
    background var(--hover-bg)
  &:focus-visible
    box-shadow inset 0 0 0 1px var(--primary)
    outline none
.qcs-tag
  max-width 90px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
.qcs-cmds
  flex 1 1 auto
  min-width 0
  display flex
  align-items center
  gap 6px
  overflow-x auto
  overflow-y hidden
  scrollbar-width none
  &::-webkit-scrollbar
    display none
    width 0
  // 右缘渐隐提示可横向滚动（mask 只取 alpha，颜色值不影响视觉）
  mask-image linear-gradient(to right, var(--text) calc(100% - 12px), transparent)
.qcs-cmd
  flex none
  display inline-flex
  align-items center
  height 22px
  padding 0 8px
  max-width 200px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  border 1px solid var(--border)
  border-radius var(--radius-xs)
  color var(--text-dark)
  cursor pointer
  transition color var(--dur-1) var(--ease), background var(--dur-1) var(--ease)
  &:hover
    color var(--text-light)
    background var(--hover-bg)
  &:focus-visible
    box-shadow inset 0 0 0 1px var(--primary)
    outline none
.qcs-empty
  font-size 11px
  color var(--text-disabled)
.terminal-footer-info
  margin-right 10px
  line-height var(--footer-h)
.terminal-footer-history
  display flex
  align-items center
.terminal-footer-qm
  // Q is now an icon-only button (5px internal padding); reduce left
  // margin so the history icon stays roughly equidistant from AI and Q
  margin-left 3px
.terminal-footer-triggers
  display flex
  align-items center
.batch-input-outer
  position relative
  .bi-full
    display none
  &.bi-show
    // hide the trigger while the popup is open so we don't show two
    // "batch input" fields at once (desktop trigger is an input-shaped affordance)
    .bi-compact
      display none
    .bi-full
      display flex
      flex-direction column
      gap 6px
      position absolute
      bottom 100%
      left 0
      z-index 1000
      background var(--main)
      padding 8px 10px
      box-shadow var(--shadow-2)
      border-radius var(--radius) var(--radius) 0 0
      min-width 360px
.batch-input-holder
  width 100px
  // antd v5 placeholder 默认黑色系(rgba(0,0,0,.25)), 暗色主题下不可见,
  // 触发器整块看起来像空白; 换主题 token 让"批量输入"提示字可见
  &::placeholder
    color var(--text-disabled)
.remote-monitor-bar-on
  .batch-input-outer.bi-show
    .bi-full
      bottom calc(100% + 28px)
// a terminal button in the batch input and "run in terminals" lists: long
// titles end in an ellipsis instead of running past the popup, and the
// button's title attribute still shows the full name on hover
.batch-tab-item
  display inline-flex
  max-width 100%
  .batch-tab-title
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

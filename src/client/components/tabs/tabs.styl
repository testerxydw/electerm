
.tabs
  position relative
  // 对齐草图 .tabbar：标签栏渲染高（tab 底部对齐）
  height var(--tabs-render-h)
  overflow hidden
  background var(--surface-0)
  border-bottom 1px solid var(--border)
  z-index 12
  ::-webkit-scrollbar
    width 0
    display none
.not-system-ui.is-mac .layout-item.v1 .tabs-inner
  margin-left 42px
.not-system-ui.is-mac.not-webapp .layout-item.v1
  .tabs-inner
    margin-left 72px
.not-system-ui.is-mac.not-webapp.pinned .layout-item.v1
  .tabs-inner
    margin-left 0
.not-system-ui.not-mac.not-webapp
  .tabs.has-corner
    .tabs-extra
      // 布局按钮(~44px) + 自绘窗口三键(94px)，溢出控制区整体让位
      right 140px
// Windows system title bar: native min/max/close are drawn over the tab bar's
// top-right (window controls overlay). The strip they occupy is whatever the
// titlebar area does not cover; 140px is the fallback for when the env() vars
// are unavailable — it has to match windowControlsOverlayWidthFallback in
// common/constants.js (the JS side of the same measurement).
.wco
  --wco-controls-width calc(100vw - env(titlebar-area-x, 0px) - env(titlebar-area-width, calc(100vw - 140px)))
  // 窗口角控件组让开原生按钮；其格子内的溢出控制区同步让位
  .tabs-corner
    right var(--wco-controls-width)
  .tabs.has-corner
    .tabs-extra
      right calc(var(--wco-controls-width) + 44px)
.tabs-inner
  position relative
  z-index 2
  padding 0
  margin-top 0
  // 对齐草图：标签底部对齐（tab 贴底，上方留白）
  display flex
  align-items flex-end
  height var(--tabs-render-h)
  overflow-x scroll
  overflow-y hidden

.tabs-wrapper
  z-index 3
  // 锁死单行: tab 为 inline-flex, wrapper 内联宽度偏小时(JS 实测的时序缺口)
  // 会被压向 min-width 换行并锁定在换行态; nowrap 后宽度偏差只降级为
  // 滚动范围一帧偏差, 由 measureWrapWidth 校准自愈
  white-space nowrap
.tab
  // 对齐草图 .tab：flex 行内布局（状态圆点 → 标题 → 关闭）
  display inline-flex
  align-items center
  justify-content center
  gap 5px
  vertical-align middle
  cursor pointer
  position relative
  padding 0 14px
  min-width 100px
  max-width 200px
  // 对齐草图 .tab：单 tab 高
  height var(--tab-item-h)
  line-height var(--tab-item-h)
  margin 0 1px 0 0
  border-radius var(--radius) var(--radius) 0 0
  background var(--surface-0)
  color var(--text-dark)
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease)
  &.tab-last
    margin-right 5px
  .tab-close
    // 对齐草图 .tab .x：关闭键 hover 淡入（opacity 过渡，替代 display 突变）
    opacity 0
    transition opacity var(--dur-1) var(--ease)
  &.active
    color var(--text)
    background var(--surface-1)
    // 顶部 2px 渐变条 + 1px 品牌描边（对齐草图 .tab.active::before / box-shadow）
    background-image linear-gradient(90deg, var(--primary), transparent 78%)
    background-repeat no-repeat
    background-size 100% 2px
    background-position 0 0
    box-shadow inset 0 0 0 1px unquote('color-mix(in srgb, var(--primary) 26%, transparent)')
  &.active-all
    font-weight bold
    .tab-count
      border-radius var(--radius-pill)
      font-weight bold
  &:hover
    background var(--hover-bg)
    .tab-close
      opacity 0.7
  &.dragover-tab::after
    position absolute
    content ''
    left -2px
    top 0
    width 1px
    border 1px dashed var(--text-dark)
    height var(--tabs-bar-h)
  &.dragover-tab-after::after
    position absolute
    content ''
    right -2px
    top 0
    width 1px
    border 1px dashed var(--text-dark)
    height var(--tabs-bar-h)
@keyframes blink
  0%
    background-color transparent
  50%
    background-color var(--primary)
  100%
    background-color transparent

.tab-terminal-feed
.tab-traffic
.tab-status
  position absolute
  left 2px
  top 2px
  width 5px
  height 5px
  border-radius var(--radius-sm)
  background-color var(--text-dark)
  &.success
    background-color var(--success)
  &.error
    background-color var(--error)
  &.processing
    background-color var(--primary)

// 对齐草图 .tab .dot：状态圆点为 7px 圆点 + 光晕，位于标题之前（flex 行内，覆盖上面的 absolute 定位）
.tab-status
  position static
  flex none
  width 7px
  height 7px
  border-radius 50%
  &.success
    background-color var(--success)
    box-shadow 0 0 6px unquote('color-mix(in srgb, var(--success) 60%, transparent)')
  &.error
    background-color var(--error)
    box-shadow 0 0 6px unquote('color-mix(in srgb, var(--error) 60%, transparent)')
  &.processing
    background-color var(--primary)
    box-shadow 0 0 6px unquote('color-mix(in srgb, var(--primary) 60%, transparent)')
.tab-traffic
  left 10px
  width 5px
  border-radius 0
  background-color var(--success)
  animation blink 2s infinite
.tab-terminal-feed
  width 12px
  height 12px
  border-radius 0
  color var(--success)
  font-size 12px
  left 2px
  top 24px
  background none
  background-color transparent !important
  animation blink 2s infinite
  &.password
    color var(--warn)
.tab-close
  position absolute
  right 5px
  cursor pointer
  top 50%
  background var(--hover-bg)
  margin-top -8px
  border-radius 100%
  color var(--text)
  height 16px
  width 16px
  text-align center
  line-height 16px
  font-size 10px
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &:hover
    background var(--error)
    color var(--primary-contrast)

// touch screens have no hover — always reveal the close icon
.is-touch-device
  .tab-close
    display block

.tabs-add-btn
  display inline-block
  vertical-align middle
  margin 0 3px 0 3px
  transition color var(--dur-1) var(--ease), background var(--dur-1) var(--ease)
  &.empty
    font-size 20px
    margin-left 20px
    margin-top 10px
  &:hover
    color var(--text-light)
.tabs-extra
  position absolute
  height 40px
  top 0
  right 0
  line-height 40px
  z-index 20

  .tabs-dd-icon
    font-size 12px
  .tabs-add-btn
    margin-top 0

// 窗口角控件组（布局菜单 + 自绘三键）：fixed 定位恒在窗口右上角，不随
// 右侧面板开合移动；面板打开时落在面板上方的标题装饰带上。仅在自定义
// 标题栏 / WCO 模式渲染（系统标题栏无可钉住的窗口顶带，见 index.jsx）。
// 承载它的格子（.has-corner）的溢出控制区按各模式的控件组宽度让位
.tabs.has-corner
  .tabs-extra
    // 默认仅布局按钮宽（mac 无自绘三键）
    right 44px
.tabs-corner
  position fixed
  top 0
  right 0
  z-index 20
  display flex
  align-items flex-start
  height var(--tabs-render-h)
  .tabs-dd-icon
    font-size 12px
    line-height var(--tabs-render-h)
  .window-controls
    position static

.window-controls
  position absolute
  right 0
  top 0
  z-index 900
  border-radius 0 0 var(--radius-xs) var(--radius-xs)
  padding 0
  // 透明底：与标签栏永久无缝（任何主题/任何变量状态都不会出现色差补丁）
  background transparent
  // 左侧 1px 发丝线分隔按钮区与标签区
  box-shadow inset 1px 0 0 0 var(--border)
  -webkit-app-region no-drag

.window-control-box
  display inline-block
  padding 5px 10px
  color var(--text)
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &:hover
    color var(--primary)
    cursor pointer
    .icon-maximize
      border-color var(--primary)
.icon-maximize
  width 10px
  height 7px
  border 1px solid var(--text)
  cursor pointer
  transition border-color var(--dur-1) var(--ease)
  // 恢复态（is-max）：完整正面矩形 + 左下露出的背面矩形（只画左边线和
  // 底边线，被正面遮挡的边不画）。错位 2px——原 left -3px/top 3px 时背
  // 面线与正面左边/底边仅差 1px，视觉上叠成“回”字；且主元素不再缩高，
  // 消除状态切换时按钮 1px 抖动
  &.is-max
    position relative
    &:before
      position absolute
      content ''
      // 标准「恢复」图标：背面完整矩形与正面框右下错位 3px 重叠，
      // 露出背面右边/下边成双窗口，状态一眼可辨；currentColor 使 hover
      // 时背面与正面一起变 --primary
      left 3px
      top 3px
      width 10px
      height 7px
      border 1px solid currentColor

.control-icon:hover
  color var(--text-light)
.tab-scroll-icon
  color var(--text-dark)
  &:hover
    color var(--text)

.window-controls
  .window-control-minimize
  .window-control-maximize
    &:hover
      background var(--hover-bg)
  .window-control-close:hover
    background var(--error)
    color var(--primary-contrast)

.system-ui
  .window-controls
    display none
.tab-title-tag
  margin-right 5px
  font-size 14px

.tab-count
  border-radius var(--radius-pill)
  padding 0 4px
  height 20px
  line-height 21px

.tab-pin
  margin-right 3px
  font-size 11px

.tab-qm-running
  font-size 11px
  color var(--primary)

// Keep every box of the title inside the tab. The tab's no-drag region is
// inherited by its children, and the OS region uses each element's full box
// without overflow clipping, so a long title's text box would cut a no-drag
// hole into the empty titlebar past the tab. Flex rows with min-width 0 let
// the text itself carry the ellipsis instead of overflowing.
.tab
  .tab-title
    display flex
    align-items center
    justify-content center
    min-width 0
    > *
      flex none
    > .tab-title
    > .tab-title-text
      flex 0 1 auto
      min-width 0
      overflow hidden
      text-overflow ellipsis
  // database tab 引擎标识：仅圆柱随标题前（徽标在 tab 窄空间会缩略失义，已去除，
  // 仅书签树行尾保留；色由 db-engine-mark.jsx 注入 --db-engine-* token）
  .db-engine-mark
    margin-right 3px

.ssh-tunnel-list-wrapper
  max-height 300px
  overflow-y auto

// 数据库会话的 tab tooltip：标题 + 连接要点（引擎/地址/库/用户）
.db-tip-title
  margin-bottom 4px
  font-weight 600

.db-tip-list
  display flex
  flex-direction column
  gap 2px

.db-tip-row
  display flex
  gap 8px

.db-tip-key
  min-width 56px
  opacity .65

.db-tip-val
  font-variant-numeric tabular-nums

// Layout and Workspace dropdown styles
.layout-workspace-dropdown
  background var(--surface-1)
  border-radius var(--radius-sm)
  box-shadow var(--shadow-2)
  min-width 200px
  padding 8px
  .ant-tabs-nav
    margin-bottom 8px

.layout-menu-content
  max-height 300px
  overflow-y auto

.layout-menu-item
  padding 6px 12px
  cursor pointer
  border-radius var(--radius-sm)
  display flex
  align-items center
  gap 8px
  color var(--text)
  &:hover
    background var(--hover-bg)
  &.active
    background var(--active-bg)
    color var(--text)

.workspace-menu-content
  max-height 300px
  overflow-y auto

.workspace-save-btn
  margin-bottom 8px

.workspace-list
  display flex
  flex-direction column
  gap 4px

.workspace-item
  padding 6px 12px
  cursor pointer
  border-radius var(--radius-sm)
  display flex
  align-items center
  justify-content space-between
  color var(--text)
  &:hover
    background var(--hover-bg)
  .workspace-delete-icon
    opacity 0
    color var(--text-dark)
    &:hover
      color var(--error)
  &:hover .workspace-delete-icon
    opacity 1

.workspace-name
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// interactive elements inside a native drag region (-webkit-app-region drag)
// must opt out or the OS swallows their clicks; Windows only has a native
// drag region in window-controls-overlay mode (.wco)
.not-webapp.not-win
.not-webapp.wco
  .tab
  .tabs-add-btn
  .window-control-box
  .tab-close
  .tab-reload
  .tabs-extra
  .tabs-corner
    -webkit-app-region no-drag

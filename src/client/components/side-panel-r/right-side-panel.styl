.right-side-panel
  position absolute
  right 0
  // Stay below the 38px tab bar (tabs.styl) — the panel never covers it in
  // either pin state; pin only changes where quick commands live.
  top 38px
  // Stay above the whole bottom stack so the footer chrome is never covered:
  // footer (+ optional monitor row) via --footer-stack-height (main.jsx), the
  // pinned quick-command box (180px) via --qm-bar-h (main.jsx), and the
  // shortcut bar via its vars (shortcut-bar.jsx sets/removes them). Two cases
  // move or remove the footer, and are handled where their sibling rules
  // already live — see shortcut-bar.styl (.shortcut-bar-on lifts the footer)
  // and term-fullscreen.styl (rdp/vnc/spice fullscreen hides it).
  bottom calc(var(--footer-stack-height, 30px) + var(--qm-bar-h, 0px) + var(--shortcut-bar-h, 0px) + var(--shortcut-bar-kb-offset, 0px))
  z-index 200
  background var(--main)
  color var(--text)
  border-left 1px solid var(--border)

  .drag-handle
    left 0
    right auto
    display block
// 右面板页签头（对齐重设计草图 .ptabs：AI / 传输 / 监控）
.right-panel-tabs
  flex none
  gap 2px
  height 34px
  padding 0 8px
  border-bottom 1px solid var(--border)
.right-panel-tab
  padding 5px 11px
  border-radius var(--radius-sm)
  color var(--text-dark)
  font-size 11.5px
  white-space nowrap
  cursor pointer
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &:hover
    background var(--hover-bg)
    color var(--text)
  &.on
    background var(--active-bg)
    color unquote('color-mix(in srgb, var(--primary) 80%, var(--text))')
.right-panel-tab-grow
  flex 1
.right-panel-tab-title
  max-width 110px
  color var(--text-dark)
  font-size 11px
// 尚未接入内容的页签占位（传输 / 监控）
.right-panel-placeholder
  padding 18px 12px
  color var(--text-dark)
  font-size 12px
  line-height 1.8
.right-side-panel-controls
  color var(--text)
  font-size 16px
  transition color var(--dur-1) var(--ease)
  &:hover
    color var(--success)
    cursor pointer
  &.right-side-panel-pin
    &.pinned
      color var(--success)
.right-side-panel-content
  padding 10px
  overflow-y scroll
  position absolute
  left 0
  top 55px
  right 0
  bottom 0
.animate-fast
  animation-duration var(--dur-2)
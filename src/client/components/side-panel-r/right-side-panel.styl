.right-side-panel
  position absolute
  right 0
  top 36px
  // Unpinned is an overlay, so stop above the footer: the footer is app chrome
  // and holds the very icon that toggles this panel, so a full-height overlay
  // would bury its own trigger. 36px is footerHeight (common/constants.js).
  // Two cases move or remove the footer, and are handled where their sibling
  // rules already live — see shortcut-bar.styl (.shortcut-bar-on lifts the
  // footer) and term-fullscreen.styl (rdp/vnc/spice fullscreen hides it).
  bottom 36px
  z-index 200
  background var(--main)
  color var(--text)
  border-left 1px solid var(--border)
  // Pinned is a dock, not an overlay: it owns the whole right column, top to
  // bottom. The layout squeezes the terminal out of the way instead
  // (layout.jsx reserves rightPanelWidth), so covering the footer is intended.
  &.right-side-panel-pinned
    top 0
    // 停靠时与内容区同高：避让底部单条 footer（三合一），否则面板会盖住 footer
    bottom var(--footer-stack-height, 36px)

  .drag-handle
    left 0
    right auto
    display block
// 右面板页签头（对齐重设计草图 .ptabs：AI / 传输 / 监控）
.right-panel-tabs
  flex none
  gap 2px
  height 34px
  padding 0 8px
  border-bottom 1px solid var(--border)
.right-panel-tab
  padding 5px 11px
  border-radius var(--radius-sm)
  color var(--text-dark)
  font-size 11.5px
  white-space nowrap
  cursor pointer
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &:hover
    background var(--hover-bg)
    color var(--text)
  &.on
    background var(--active-bg)
    color unquote('color-mix(in srgb, var(--primary) 80%, var(--text))')
.right-panel-tab-grow
  flex 1
.right-panel-tab-title
  max-width 110px
  color var(--text-dark)
  font-size 11px
// 尚未接入内容的页签占位（传输 / 监控）
.right-panel-placeholder
  padding 18px 12px
  color var(--text-dark)
  font-size 12px
  line-height 1.8
.right-side-panel-controls
  color var(--text)
  font-size 16px
  transition color var(--dur-1) var(--ease)
  &:hover
    color var(--success)
    cursor pointer
  &.right-side-panel-pin
    &.pinned
      color var(--success)
.right-side-panel-content
  padding 10px
  overflow-y scroll
  position absolute
  left 0
  top 55px
  right 0
  bottom 0
.animate-fast
  animation-duration var(--dur-2)
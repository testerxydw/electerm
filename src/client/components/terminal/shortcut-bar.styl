// shortcut-bar
// sits in reserved space at the bottom of the viewport (see layout.jsx +
// .shortcut-bar-on rule below). Height tracks --shortcut-bar-h which the
// component sets from the shortcutBarHeight constant.

.shortcut-bar
  position fixed
  left 0
  right 0
  bottom 0
  height var(--shortcut-bar-h, 44px)
  z-index 400
  display flex
  align-items stretch
  background var(--surface-1)
  border-top 1px solid var(--border)
  user-select none
  -webkit-user-select none

.shortcut-bar-fixed
  display flex
  align-items stretch
  flex-shrink 0
  border-right 1px solid var(--border)

.shortcut-bar-icon-btn
  width 44px
  display flex
  align-items center
  justify-content center
  background transparent
  border none
  color var(--text)
  cursor pointer
  font-size 16px
  // upstream 5.5.66: long-press = keep sending the key; platform must not treat
  // the hold as its own gesture (iOS callout / Android selection handles)
  -webkit-touch-callout none
  touch-action manipulation
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &:active
    background var(--hover-bg)
  &:hover
    color var(--text-light)
    background var(--hover-bg)

.shortcut-bar-scroll
  flex 1
  display flex
  align-items center
  gap 6px
  padding 0 8px
  overflow-x auto
  overflow-y hidden
  scrollbar-width none
  -webkit-overflow-scrolling touch
  // a press that turns into a drag is a scroll of the button row
  touch-action pan-x
  &::-webkit-scrollbar
    display none

// A held button now means "keep sending this key", so the platform must not
// treat the hold as its own gesture:
//   - the iOS callout (Copy/Look Up) and Android's text-selection handles
//     would swallow it — same reason .term-wrap suppresses them;
//   - touch-action keeps the hold from turning into a scroll of the page; the
//     bar's own horizontal scroll lives on .shortcut-bar-scroll, which is a
//     separate element, so this only affects the button itself.
.shortcut-bar-btn
  -webkit-touch-callout none
  touch-action manipulation
  flex-shrink 0
  height 32px
  min-width 32px
  padding 0 10px
  display inline-flex
  align-items center
  justify-content center
  border-radius var(--radius-sm)
  border 1px solid var(--border)
  background var(--surface-2)
  color var(--text)
  font-size 13px
  cursor pointer
  white-space nowrap
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &:active
    background var(--active-bg)
    color var(--text)
    box-shadow var(--accent-glow)
  &:hover
    color var(--text-light)
    background var(--hover-bg)
  // held down and repeating: keep the :active look for as long as the key is
  // being re-sent, so the user can see the auto-repeat is running
  &.repeating
    background var(--primary)
    color var(--primary-contrast)

    display none

// while the bar is visible, lift the footer + reserve space so nothing is
// covered (terminal area is shrunk by layout.jsx via store.shortcutBarVisible;
// --shortcut-bar-kb-offset raises both bar + footer above a page-overlaying
// system input panel on iOS / HarmonyOS)
.shortcut-bar-on
  .main-footer
    bottom calc(var(--shortcut-bar-h, 44px) + var(--shortcut-bar-kb-offset, 0px))
  .remote-monitor-bar
    bottom calc(var(--shortcut-bar-h, 44px) + var(--shortcut-bar-kb-offset, 0px) + 30px)
  // The right panel lifts itself via its own bottom calc, which already
  // includes --shortcut-bar-h + --shortcut-bar-kb-offset (right-side-panel.styl);
  // the vars are set by shortcut-bar.jsx while the bar is on. Mobile is
  // excluded there by its full-screen drawer override (mobile.styl).
  .qm-wrap-tooltip
    bottom calc(var(--footer-stack-height, 30px) + var(--shortcut-bar-h, 44px) + var(--shortcut-bar-kb-offset, 0px))

// --- edit modal -----------------------------------------------------------

.shortcut-edit-wrap
  .custom-modal-content
    max-width 92vw
.shortcut-edit-section
  margin-bottom 16px
  &:last-child
    margin-bottom 0
.shortcut-edit-section-title
  margin-bottom 8px
  color var(--text)
  font-weight bold
  font-size 13px

.shortcut-active-list
  display flex
  flex-wrap wrap
  gap 6px
  min-height 48px
  padding 8px
  border 1px dashed var(--border-strong)
  border-radius var(--radius-sm)
  background var(--surface-0)
.shortcut-active-empty
  color var(--text-dark)
  font-size 12px
  width 100%
  text-align center
  line-height 32px

.shortcut-active-item
  display inline-flex
  align-items center
  gap 4px
  height 30px
  padding 0 4px 0 10px
  border-radius var(--radius-sm)
  background var(--surface-2)
  border 1px solid var(--border)
  color var(--text)
  font-size 13px
.shortcut-active-label
  white-space nowrap
.shortcut-active-remove
  display flex
  align-items center
  justify-content center
  width 20px
  height 20px
  border none
  background transparent
  color var(--text-dark)
  border-radius var(--radius-sm)
  cursor pointer
  font-size 11px
  &:hover
    color var(--error)
    background var(--hover-bg)

.shortcut-candidate-list
  display flex
  flex-wrap wrap
  gap 6px
  max-height 180px
  overflow-y auto
  padding 4px
.shortcut-candidate-item
  height 30px
  min-width 34px
  padding 0 10px
  display inline-flex
  align-items center
  justify-content center
  border-radius var(--radius-sm)
  border 1px solid var(--border)
  background var(--surface-1)
  color var(--text)
  font-size 13px
  cursor pointer
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease), opacity var(--dur-1) var(--ease)
  &:active
    background var(--hover-bg)
  &:hover
    color var(--text-light)
    background var(--hover-bg)
  &.added
    opacity 0.45
    cursor default

.shortcut-custom-form
  display flex
  gap 8px
  align-items center
  flex-wrap wrap
  position relative
.shortcut-search-input
  flex 1
  min-width 160px
.shortcut-custom-input
  flex 1
  min-width 120px
.shortcut-custom-select
  flex 1
  min-width 120px
  width 120px
.shortcut-custom-key
  min-width 110px
  width 110px
.shortcut-custom-add
  height 32px
  white-space nowrap

.shortcut-edit-footer
  justify-content space-between
  width 100%

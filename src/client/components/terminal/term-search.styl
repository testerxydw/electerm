// 大小写/整词/正则开关（SearchBar 的 suffix 插槽内）
.term-search-opt-icon
  margin 0 3px
  color var(--text-light)
  font-size 15px
  cursor pointer
  border-radius var(--radius-xs)
  transition color var(--dur-1) var(--ease), background var(--dur-1) var(--ease)
  &:hover
    color var(--text)
  &.term-search-on
    background var(--surface-2)
    color var(--text-dark)
// 查找条挂载位：SessionControl 顶栏右侧内联展开（原右上浮层已废弃）
// 必须 inline-flex：父级 .term-controls 是 float 块容器，块级 flex 会独占
// 一行，把后面的搜索/全屏图标挤到下一行
.term-search-wrap
  display inline-flex
  vertical-align middle
  align-items center
  min-width 0
  margin-right 4px

// shared remote session (rdp/vnc/spice) shell, see session-shell.jsx
// 注：DOM 类名保持 remote-session-* 前缀不变（禁止改类名约束）

.remote-session-wrap
  display flex
  flex-direction column
  width 100%
  height 100%
  min-height 0
  background var(--surface-1)

// antd Spin root carries the className, both levels must pass the height on
// or the session inside has nothing to resolve `height: 100%` against
.remote-session-spin
  height 100%
  > .ant-spin-container
    height 100%

// control bar: one row while there is room, wraps to more rows when the
// window is narrow, so no action icon ever gets pushed out of reach
.remote-session-control
  position relative
  flex 0 0 auto
  display flex
  flex-wrap wrap
  align-items center
  justify-content space-between
  // 高度口径见 tokens.styl --session-bar-h：单行 = 32，换行后 n 行 = 32n。
  // 行盒已含上下呼吸，row-gap 留 0，否则换行高会变成 32n+4(n-1)。
  min-height var(--session-bar-h)
  line-height var(--session-bar-h)
  row-gap 0
  padding 0 var(--session-bar-pad-x)
  z-index 300

.remote-session-control-left
.remote-session-control-right
  display flex
  flex-wrap wrap
  align-items center
  // 条目间距单点在这里：协议不再往栏内条目塞 mg1l/mg2r 之类的外边距，
  // 否则和 column-gap 叠起来，三端间距又会各走各的
  column-gap 8px
  row-gap 0
  min-width 0

.remote-session-control-right
  margin-left auto

// 顶栏图标统一 16px。三端往栏里塞的图标默认尺寸不一致（RDP 的文件传输自己写了
// 16px，重连/编辑/全屏走 antd 默认 14px），同一行里看上去"轻重"不同。
// 用后代选择器而不是 >：Tooltip / HelpIcon 会在栏直接子和 .anticon 之间插一层
// span。Select 的下拉箭头与 Switch 的内部图标显式排除 —— 它们由 antd 的尺寸
// token 管，跟着改会让控件变形。
.remote-session-control-left
.remote-session-control-right
  .anticon
    font-size 16px
  .ant-select-arrow .anticon
  .ant-select-suffix .anticon
    font-size inherit

// A（连接信息）与 B（会话操作）之间的一条竖线：顺序改了以后，读起来仍然是
// "信息一断、操作一断"，不靠间距猜
.remote-session-info
  &::after
    content ''
    width 1px
    height 16px
    flex none
    margin-left 4px
    align-self center
    background var(--border)

// 连接信息（SessionInfo），桌面名是次要层级但要能一眼挑出来
.remote-session-info-name
  font-weight 600

.remote-session-viewport
  position relative
  flex 1 1 auto
  display flex
  min-width 0
  min-height 0
  overflow auto
  // scrolled when fit is off, i.e. the remote surface at its own size
  &::-webkit-scrollbar
    width 16px
    height 16px
    background var(--surface-0)
  &::-webkit-scrollbar-track
    background var(--surface-0)
    box-shadow var(--shadow-1)
  &::-webkit-scrollbar-thumb
    background var(--primary)
    border-radius 0
  &::-webkit-scrollbar-corner
    background var(--surface-0)
  > *
    flex 0 0 auto
    margin auto

// fit: scale the remote surface to the viewport, keeping the source aspect
// ratio, so at most one axis keeps empty margin and fullscreen has as little
// empty space as the ratio allows
.remote-session-wrap.fit
  .remote-session-viewport
    overflow hidden
    > *
      width 100%
      height 100%
      margin 0

// surface that should always fill the viewport (noVNC sizes its canvas itself)
.remote-session-fill
  width 100%
  height 100%

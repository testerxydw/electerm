.custom-modal-wrap
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  overflow auto
  outline 0

.custom-modal-mask
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  background var(--mask)

.custom-modal-container
  position relative
  display flex
  align-items flex-start
  justify-content center
  min-height 100%
  padding 24px
  word-break break-word

.custom-modal-content
  position relative
  background var(--main)
  // 对齐 v4 草图 ⑤：14px 圆角 + 描边环 + --shadow-3（浮层层级感）
  border-radius var(--radius-lg)
  box-shadow 0 0 0 1px var(--border), var(--shadow-3)
  margin-top 50px
  max-width calc(100vw - 48px)

  &.no-body
    .custom-modal-header
      border-bottom none
    .custom-modal-footer
      border-top none

.custom-modal-header
  display flex
  align-items center
  justify-content space-between
  padding 16px 24px
  border-bottom 1px solid var(--border)
  // 对齐 v4 草图 ⑤：标题栏 8% 品牌渐变洗染（与 v4 面板语言一致）
  background unquote('linear-gradient(90deg, color-mix(in srgb, var(--primary) 8%, transparent), transparent)')

.custom-modal-title
  font-size 16px
  font-weight 600
  color var(--text)
  line-height 1.5
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.custom-modal-close
  display flex
  align-items center
  justify-content center
  width 32px
  height 32px
  padding 0
  margin-left 8px
  background transparent
  border none
  border-radius var(--radius-sm)
  color var(--text)
  cursor pointer
  transition background var(--dur-2) var(--ease)
  &:hover
    background var(--hover-bg)
  &:focus
    outline none

.custom-modal-body
  padding 0 24px 24px 24px
  color var(--text)

.custom-modal-footer
  padding 12px 24px
  border-top 1px solid var(--border)
  text-align right

.custom-modal-footer-buttons
  display flex
  justify-content flex-end
  gap 8px

.custom-modal-ok-btn,
.custom-modal-cancel-btn
  padding 6px 16px
  border none
  border-radius var(--radius-sm)
  cursor pointer

// 主按钮（对齐 v4 草图 ⑤：hover 上浮 1px + 主色投影，transform 零布局位移）
.custom-modal-ok-btn
  transition transform var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease)
  &:hover
    transform translateY(-1px)
    box-shadow 0 6px 18px unquote('color-mix(in srgb, var(--primary) 40%, transparent)')
  font-size 14px
  transition background var(--dur-2) var(--ease)

.custom-modal-ok-btn
  background var(--primary)
  color var(--primary-contrast)

.custom-modal-cancel-btn
  background var(--main)
  color var(--text)

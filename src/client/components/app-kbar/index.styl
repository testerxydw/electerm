// 应用快捷键条（对齐重设计草图 .kbar：30px / kbd 胶囊 / hover 中性底）

.app-kbar
  position absolute
  left calc(var(--left-side-bar-width, 50px) + 1px)
  right 0
  bottom var(--footer-stack-height, 62px)
  height 30px
  z-index 205
  display flex
  align-items center
  gap 6px
  padding 0 10px
  overflow-x auto
  scrollbar-width none
  background var(--surface-0)
  box-shadow inset 0 1px 0 0 var(--border)
  &::-webkit-scrollbar
    display none

.app-kbar-item
  display inline-flex
  align-items center
  gap 6px
  flex none
  padding 3px 9px
  border-radius var(--radius-sm)
  color var(--text-dark)
  font-size 11px
  white-space nowrap
  cursor pointer
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &:hover
    background var(--hover-bg)
    color var(--text)
  &:focus-visible
    outline 1px solid var(--primary)
    outline-offset 1px
  kbd
    font-family var(--font-mono)
    font-size 10px
    border 1px solid var(--border)
    border-radius var(--radius-xs)
    padding 0 4px
    color var(--text-dark)

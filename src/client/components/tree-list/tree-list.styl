
.tree-control-btn
  display inline-flex
  align-items center
  justify-content center
  margin-left 3px
  width 16px
  line-height 30px
  height 30px
.tree-item
  display flex
  position relative
  // 对齐草图 .node：行高 30px、圆角 8px、内边距更舒展
  line-height 30px
  padding-left 8px
  border-radius var(--radius-sm)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  // 分组标题对齐草图 .grp：轻量小字（原为 14px 粗体，视觉过重）
  &.is-category
    .tree-item-title
      font-weight 600
      font-size 12px
      color var(--text-dark)

  &.kb-selected
    outline 1px dashed var(--primary)
  &.item-dragover
  &:hover
    background var(--hover-bg)
    color var(--text)
    cursor pointer
  // 选中态与 hover 原本共用同一底色、无法区分；改为品牌着色 + 左侧色条
  &.selected
    background var(--active-bg)
    color var(--text)
    &::before
      content ''
      position absolute
      left 0
      top 7px
      bottom 7px
      width 2px
      border-radius var(--radius-pill)
      background var(--primary)
  // ctrl/shift 多选中的行: 弱于单选的着色, 与 hover/kb-selected 可区分
  &.multi-selected
    background var(--active-bg)
    color var(--text)
  &.item-dragover-top
    border 2px solid var(--primary)
.tree-item-title
  flex-grow 1
  line-height 30px
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

// database 书签引擎标识：圆柱图标 + 行尾描边徽标（色取 --db-engine-* token，
// 由 db-engine-mark.jsx 内联注入，此处只管形态与间距）
.tree-item .db-engine-mark
  margin-right 5px
.db-engine-badge
  flex none
  align-self center
  border 1px solid currentColor
  margin-left 6px
  margin-right 4px
  opacity .85

.sidebar-panel .tree-item-title
   max-width 100%
.with-plus
  &:after
    content '+'
    position absolute
    font-size 16px
    top 2px
    right 2px
.add-menu-wrap
  .tree-item-title
    padding-right 20px
  .is-category
    .tree-item-title
      padding-right 40px
  .edit-icon.tree-control-btn
  .open-all-icon.tree-control-btn
    position absolute
    right 0
    top 0
  .open-all-icon.tree-control-btn
    right 20px
.group-container
  padding-left 12px
  position relative
  line-height 30px
.tree-expander
  position absolute
  left 0
  top 0
  width 12px
  font-size 11px
  line-height 30px

.category-color-tag
  display inline-block
  width 12px
  height 12px
  margin-right 6px
  border-radius var(--radius-xs)
  border 1px solid var(--border)
  vertical-align middle

.move-item-tree-wrap
  max-height 300px
  overflow-y auto
  padding 8px

.tree-list
  display flex
  flex-direction column
  height 100%
  overflow hidden

.tree-list-header
  flex-shrink 0

.item-list-wrap
  flex 1
  overflow-y auto
  min-height 0
  position relative
  // the highlighted row is the focus indicator, the browser outline around the
  // whole list is just noise once any click inside it has focused it
  &:focus
    outline none

.tree-sort-wrap
  position relative
.tree-sort-dropdown
  display none
  position absolute
  right 0
  top 100%
  margin-top 4px
  background var(--surface-0)
  border 1px solid var(--border)
  border-radius var(--radius-sm)
  padding 4px
  z-index 100
  box-shadow var(--shadow-2)
&.open
  .tree-sort-dropdown
    display block

.tree-sort-trigger
  cursor pointer
  transition color var(--dur-1) var(--ease)
  &:hover
    color var(--primary)
  &.active
    color var(--primary)

.tree-sort-popover-item
  padding 4px 8px
  border-radius var(--radius-xs)
  cursor pointer
  white-space nowrap
  font-size 12px
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  &:hover
    background var(--hover-bg)
  &.active
    color var(--primary)

.tree-list-virtual-spacer
  position relative
  width 100%

.tree-list-virtual-row
  position absolute
  left 0
  right 0

.tree-list-row
  box-sizing border-box
  width 100%
  position relative
  &.is-hidden
    visibility hidden
  &:hover
    .tree-item-title
      padding-right 60px
    .tree-item-op-wrap
      opacity 1
      pointer-events auto
    // hover 时操作按钮接管行尾，徽标让位隐藏
    .db-engine-badge
      opacity 0
.add-menu-wrap
.sidebar-panel
  .tree-list-row
    &:hover
      .tree-item-title
        padding-right 20px
      .db-engine-badge
        opacity 0

.tree-list-row-group
  position relative
  padding-left 12px

.tree-list-editor-overlay
  position absolute
  right 4px
  z-index 4

.tree-item-op-wrap
  position absolute
  top 0
  bottom 0
  right 4px
  display flex
  align-items center
  z-index 3
  opacity 0
  pointer-events none
  transition opacity var(--dur-1) var(--ease)
  &.is-active
    opacity 1
    pointer-events auto
// touch screens have no hover — always reveal the hover-only action icons
.is-touch-device
  .tree-list-row
    .tree-item-title
      padding-right 60px
    .tree-item-op-wrap
      opacity 1
      pointer-events auto
    // 操作按钮常显时徽标同样让位
    .db-engine-badge
      opacity 0
  .add-menu-wrap
  .sidebar-panel
    .tree-list-row
      .tree-item-title
        padding-right 20px
      .db-engine-badge
        opacity 0

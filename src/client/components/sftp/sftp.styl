// 文件面板高度全链路由 flex 分配（T3b）：.term-sftp-box 列 → Splitter →
// .sftp-pane-wrap → .sftp-wrap → .sftp-section → Spin → .sftp-panel → .file-list
// → .sftp-table → .sftp-table-content。JS 不再为这条链路下发任何 px 高度。
.sftp-wrap
  flex 1 1 0
  min-height 0
  display flex
  flex-direction row
.sftp-section
  flex 1 1 0
  min-width 0
  min-height 0
  display flex
  flex-direction column
  // antd Spin（v6）自带两级包裹：.ant-spin > .ant-spin-container，
  // 任一级不断高都会让内容退回 auto 高
  > .ant-spin
    flex 1 1 0
    min-height 0
    display flex
    flex-direction column
    > .ant-spin-container
      flex 1 1 0
      min-height 0
      display flex
      flex-direction column
// 文件面板的两行条：title / address 各对齐单行节奏（高度口径同 tokens.styl）。
// 不用 display flex：title 行依赖 .alignright 与 .elli，flex 会同时破坏
// 右对齐和省略号，而单行高度由 line-height + min-height 已经足够。
.sftp-panel-title
  flex none
  min-height var(--session-bar-h)
  line-height var(--session-bar-h)
  padding 0 var(--session-bar-pad-x)

// 远端面板标题行：A 区（身份文本）在左，刷新动作贴右端 —— 顺序读得通，
// 动作也仍在一个拇指可及的位置
.sftp-panel-title-remote
  display flex
  align-items center
  gap 8px
  .sftp-panel-title-text
    min-width 0
    font-weight 600
    position relative
    padding-right 10px
    &::after
      content ''
      position absolute
      right 0
      top 50%
      transform translateY(-50%)
      width 1px
      height 16px
      background var(--border)
  .sftp-panel-refresh
    margin-left auto
    // mg1r 是给流式排布用的，这里已经贴右端，留着会让图标顶出内边距
    margin-right 0
.sftp-title-wrap
  position relative
  flex none
  min-height var(--session-bar-h)
  line-height var(--session-bar-h)
  padding 0 var(--session-bar-pad-x)
.sftp-item
  position relative
  z-index 3
  padding 0
  line-height 26px
  height 32px
  user-select none
  margin-bottom 4px
  &:nth-child(even)
    .sftp-file-prop
      background var(--surface-2)
  &:hover
    .sftp-file-prop
      background-color var(--hover-bg)
      color var(--text)
    .sftp-file-prop:first-child
      box-shadow inset 2px 0 0 0 var(--primary)
  &.selected
    .sftp-file-prop
      background-color var(--active-bg)
      color var(--text)
    .sftp-file-prop:first-child
      box-shadow inset 2px 0 0 0 var(--primary)
.sftp-history
  position absolute
  left 0
  top 100%
  right 0
  z-index 30
  box-shadow none
  border none
  height 0
  background var(--main)
  overflow hidden
  border-radius var(--radius-xs)
  &.focused
    height auto
    border 1px solid var(--border-strong)
    box-shadow var(--shadow-2)

.sftp-history-item
  padding 5px 10px
  cursor pointer
  border-bottom 1px solid var(--border)
  &:hover
    background var(--primary)
    color var(--primary-contrast)

.sftp-item-title
  width 100%
.sftp-item-title
    width 75%
.sftp-item-size
  width 24%
.sftp-status-success
  color var(--success)
.sftp-status-exception
  color var(--error)
.sftp-status-active
  color var(--primary)

.virtual-file
  .sftp-item
    position absolute
    left 0
    right 10px
    bottom 0
    top 0
    z-index 1
    height 100%
    padding 0
    margin 0

.file-icon
  position absolute
  left 10px
  top 10px
  font-size 50px
.file-props-div
  display flex
  width 100%
.file-props
  margin-left 70px

.sftp-sort-btn
  &.active
    font-weight bold
    color var(--text-light)

//list table
.sftp-file-prop
  flex 0 0 auto
  height 32px
  line-height 30px
  padding 0 5px
  background var(--main)
  transition background var(--dur-1) var(--ease), color var(--dur-1) var(--ease)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  pointer-events none
  cursor default
  color var(--text)

.file-bg
  position absolute
  left 0
  top 0
  right 0
  height 32px
  z-index 3

.sftp-header-item
  height 28px
  line-height 25px
  padding 0 5px
  background var(--main)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis

.sftp-file-table-header
  flex none
  height 30px
.sftp-table
  z-index 2
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  &:hover
    ::-webkit-scrollbar
      width 12px
// 滚动容器吃满表头之外的空间：虚拟列表的可视高由 ResizeObserver 实测
.sftp-table-content
  flex 1 1 0
  min-height 0
.sftp-item
  &.sftp-dragover
    .sftp-file-prop
      background var(--primary) !important
      color var(--text) !important
  &.sftp-dragover-multi
    &:after
    &:before
      position absolute
      left 2px
      top 2px
      width 100%
      height 100%
      background var(--main-lighter)
      content ''
      z-index -1
    &:after
      left 4px
      top 4px
.icon-holder
  width 1em
  display inline-block
.symbolic-link-icon
  margin-right 2px

//sftp
.sftp-panel
  background var(--main)
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column

.file-list
  // 对齐 v4 草图 ③：列表容器从「贴在背景上」变成「一块面板」
  flex 1 1 0
  min-height 0
  display flex
  flex-direction column
  background var(--surface-1)
  border-radius var(--radius-sm)
  box-shadow 0 0 0 1px var(--border)
  ::-webkit-scrollbar-thumb
    background-color var(--primary) !important

// 大小列等宽字体（对齐 v4 草图：纵向自然对齐）
.sftp-file-prop.shi-size
  font-family var(--font-mono)
  font-size 11px

.file-header-context-menu
  position fixed
  z-index 999

.sftp-keyword-bar
  flex none
  display flex
  align-items center
  justify-content space-between
  padding-top 4px
  padding-bottom 4px
  background var(--main-darker)
  border-bottom 1px solid var(--primary)
  .sftp-keyword-bar-icon
    color var(--success)
  .sftp-keyword-bar-text
    flex 1
    min-width 0
  .sftp-keyword-bar-close:hover
    color var(--error)

.sftp-addr-menu-icon
  cursor pointer
  font-size 14px
  color var(--text)
  &:hover
    color var(--text-light)

.sftp-addr-menu-content
  display flex
  align-items center
  padding 4px 0
  flex-wrap wrap
  gap 4px

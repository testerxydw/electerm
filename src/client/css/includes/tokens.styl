// 设计 token（美化规范 §2 · Layer 1，v4「Tinted Console」深度设计层）
//
// 全部为新增变量，不覆盖任何既有变量：
//   · 派生变量跟随 --text / --main / --primary 自动适配任意主题（含 310 个 iTerm 主题）
//   · 静态变量与主题无关
//
// ⚠️ 禁止在此引用 --main-darker / --main-lighter：
//    ui-theme.jsx 的 darker() 缺上界钳制，会产出非法颜色（如 '#0'），
//    引用它会让整条声明失效。详见规范 §2.1 / §3.9。
//
// ⚠️ 含 `in` 的 color-mix(...) 必须用 unquote() 包裹：
//    Stylus 的 `in` 是运算符，裸写会报 "illegal unary in"。
:root
  // ---- v4 派生：品牌浸染表面色阶（4 级，色相跟随主题）----
  --surface-0 unquote('color-mix(in srgb, var(--primary) 4%, var(--main-dark))')
  --surface-1 unquote('color-mix(in srgb, var(--primary) 2%, var(--main))')
  --surface-2 var(--main-light)
  --surface-3 unquote('color-mix(in srgb, var(--text) 6%, var(--main))')

  // ---- 派生：分隔、边框、交互态 ----
  --border unquote('color-mix(in srgb, var(--text) 12%, transparent)')
  --border-strong unquote('color-mix(in srgb, var(--text) 22%, transparent)')
  --hover-bg unquote('color-mix(in srgb, var(--text) 7%, transparent)')
  --active-bg unquote('color-mix(in srgb, var(--primary) 16%, transparent)')
  --accent-wash unquote('color-mix(in srgb, var(--primary) 10%, var(--main))')

  // ---- v4 派生：光晕激活态（激活/选中/按下共用；焦点环保持描边式）----
  --accent-glow unquote('0 0 0 1px color-mix(in srgb, var(--primary) 45%, transparent), 0 2px 16px color-mix(in srgb, var(--primary) 30%, transparent)')

  // ---- v4 派生：状态色底芯片（14% 色底 + 同色彩字）----
  --success-bg unquote('color-mix(in srgb, var(--success) 14%, var(--main))')
  --error-bg unquote('color-mix(in srgb, var(--error) 14%, var(--main))')
  --warn-bg unquote('color-mix(in srgb, var(--warn) 14%, var(--main))')
  --info-bg unquote('color-mix(in srgb, var(--info) 14%, var(--main))')

  // ---- 数据库引擎标识色（书签树 / tab 的 db 圆柱与徽标共用）----
  // 官方品牌色：mysql #4479A1 / redis #DC382D / postgres #336791
  // 深色基底=原色 mix 30% white 提亮（保对比度）；浅色覆盖见 .theme-light
  // tidb / oceanbase 协议同源 mysql，继承同一色（引擎名由徽标文字区分）
  --db-engine-mysql #7CA1BD
  --db-engine-redis #E7746C
  --db-engine-postgres #7095B2
  --db-engine-tidb var(--db-engine-mysql)
  --db-engine-oceanbase var(--db-engine-mysql)

  // ---- 静态：圆角（v4：整体上调一档）----
  --radius-xs 4px
  --radius-sm 8px
  --radius 10px
  --radius-lg 14px
  --radius-pill 999px

  // ---- 静态：阴影与遮罩（v4：略加深）----
  --shadow-1 0 1px 2px rgba(0, 0, 0, .32)
  --shadow-2 0 4px 14px rgba(0, 0, 0, .36)
  --shadow-3 0 18px 48px rgba(0, 0, 0, .5)
  --mask rgba(0, 0, 0, .45)

  // ---- 静态：间距 / 字号 ----
  --sp-1 4px
  --sp-2 8px
  --sp-3 12px
  --sp-4 16px
  --sp-5 24px
  --fs-xs 11px
  --fs-sm 12px
  --fs 13px
  --fs-lg 16px

  // ---- 骨架高度（S2 单点化）----
  // 顶栏（终端控制条 / DB 工具条）统一高度。
  // 与 JS 侧 src/client/common/constants.js 的 termControlHeight=32 互为镜像
  // （JS 布局扣减拿不到 CSS 变量），两值必须同步，由 s2-tokens.spec.js 锁定
  --session-bar-h 32px
  // 顶部标签栏高度：布局预留、渲染高度与 store/init-state.js tabsHeight=36
  // 三处同源；.tabs 渲染高必须等于该值，否则 tab 底部会压住终端顶栏
  --tabs-bar-h 36px
  // 单个 tab 高（标签栏内容区 = 36 - 1px 下边框，tab 底部贴边框上缘）
  --tab-item-h 32px
  // 底部状态栏高度；与 JS 侧 footerHeight=30 互为镜像，同由 s2-tokens.spec.js 锁定
  --footer-h 30px

  // ---- 静态：动效 ----
  --dur-1 120ms
  --dur-2 180ms
  --ease cubic-bezier(.4, 0, .2, 1)

  // ---- v4 静态：等宽点缀（仅用于新增声明：路径/大小/次数/版本号）----
  --font-mono ui-monospace, 'SF Mono', Menlo, Consolas, 'Noto Sans Mono CJK SC', monospace

  // ---- v4 派生：首页品牌光晕（no-session 首页顶部 radial 浸染）----
  --hero-glow unquote('radial-gradient(560px 220px at 50% 0, color-mix(in srgb, var(--primary) 14%, transparent), transparent 72%)')

// ---- v4 方案 B：浅色主题精确阴影分档（ui-theme.jsx 按 main 明暗切换 .theme-light）----
.theme-light
  --shadow-1 0 1px 2px rgba(0, 0, 0, .06)
  --shadow-2 0 4px 12px rgba(0, 0, 0, .10)
  --shadow-3 0 18px 48px rgba(0, 0, 0, .14)
  // 数据库引擎色浅色=官方原色（tidb/oceanbase 继承 mysql 的 var 引用自动跟随）
  --db-engine-mysql #4479A1
  --db-engine-redis #DC382D
  --db-engine-postgres #336791
